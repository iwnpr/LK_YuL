@code {
    private string? _url;

    protected override void OnInitialized()
    {
    _url = _configuration.GetSection("Links:CRS").Value;
    }

    private List<string> MenuItems = new List<string>()
    {
        "active", string.Empty, string.Empty, string.Empty, string.Empty, string.Empty
    };

    private void ItemCLick(byte id) => MenuItems[id] = MenuItems[id].Equals("active") ? string.Empty : "active";
}

