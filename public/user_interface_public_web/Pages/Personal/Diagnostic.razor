<section class="sign">
    <div class="l-default">
        <h1 class="parameters__title title title--h1">Диагностика</h1>

        <div class="caption">Параметры подключения</div>

        <div class="sign__platform">
            <div class="sign__platform-text"><strong>IP-адрес:</strong> @_connection?.IpAddress</div>
            <div class="sign__platform-text"><strong>UserAgent:</strong> @* @_connection?.UserAgent *@ @_agent </div>
            @* <div class="sign__platform-text"><strong>Сертификат:</strong> @_connection?.SerialNumber</div> *@
        </div>

        <div class="caption">Информация об установленном плагине</div>

        <div class="sign__platform">
            <div class="sign__platform-text"><strong>Криптопровайдер:</strong> @_info?.PluginInfo?.CSPName</div>
            <div class="sign__platform-text"><strong>Версия плагина:</strong> @_info?.PluginInfo?.CurrentPluginVersion</div>
            <div class="sign__platform-text"><strong>Версия криптопровайдера:</strong> @_info?.PluginInfo?.Version</div>
        </div>

        <div class="caption">Информация о КриптоПро</div>

        <div class="sign__platform">
            <div class="sign__platform-text"><strong>Серийный номер:</strong> @_info?.CryptoProInfo?.SerialNumber</div>
            <div class="sign__platform-text"><strong>Срок действия:</strong> @_info?.CryptoProInfo?.ValidTo</div>
            <div class="sign__platform-text"><strong>Дата установки:</strong> @_info?.CryptoProInfo?.FirstInstall</div>
            <div class="sign__platform-text"><strong>Тип лицензии:</strong> @_info?.CryptoProInfo?.LicType</div>
            <div class="sign__platform-text"><strong>Организация:</strong> @_info?.CryptoProInfo?.CompanyName</div>
        </div>

        <div class="sign__sertificates">
            <div class="caption">Сертификаты</div>
            <div class="sign__sertificates-content">
                @foreach (var item in _certificates)
        {
                @if (true)
                {
                    DateTime.TryParse(item.ValidToDate, out DateTime _validTo);
                    <div class="sign__sertificates-item" @onclick=@(() => { _certificate = item; _show = true; })>
                        <div class="sign__sertificates-icon"><img src="img/svg/@(_validTo > DateTime.Now ? "checked-border.svg" : "x.svg")"></div>
                        <div class="sign__sertificates-title">@item.SubjectName.Split(", ").First(_cn => _cn.Contains("CN=")).Replace("CN=", "") </div>
                        <div class="sign__sertificates-text">Действителен до: @DateTime.Parse(item.ValidToDate).ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                }
        }

            </div>
        </div>


        <div class="sign__sertificates" style="margin-top:29px;">
            <div class="caption">Необходимое ПО</div>
            <div class="sign__sertificates-content">
                <div class="sign__sertificates-item">
                    <div class="sign__uploads-icon"> <img src="img/Yandex.Browser_icon.svg" width="24" alt=""></div>
                    <div class="sign__uploads-title">Yandex браузер</div>
                    <div class="sign__uploads-subtitle"></div>
                    <div class="sign__uploads-input sign__uploads-input--green" @onclick="@(() => _jsr.InvokeVoidAsync("open", $"{_configuration.GetSection("Links:Yandex").Value}", "_blank"))">
                        <span>Скачать</span>
                    </div>
                </div>

                <div class="sign__sertificates-item">
                    <div class="sign__uploads-icon"> <img src="img/Chromium_Logo.svg" width="24" alt=""></div>
                    <div class="sign__uploads-title">Chrome GOST</div>
                    <div class="sign__uploads-subtitle"></div>
                    <div class="sign__uploads-input sign__uploads-input--green" @onclick="@(() => _jsr.InvokeVoidAsync("open", $"{_configuration.GetSection("Links:Chromium").Value}", "_blank"))">
                        <span>Скачать</span>
                    </div>
                </div>

                <div class="sign__sertificates-item">
                    <div class="sign__uploads-icon"><img src="img/svg/danger.svg" alt=""></div>
                    <div class="sign__uploads-title">КриптоПро ЭЦП Browser plug-in</div>
                    <div class="sign__uploads-subtitle"></div>
                    <div class="sign__uploads-input sign__uploads-input--green" @onclick="@(() => _jsr.InvokeVoidAsync("open", $"{_configuration.GetSection("Links:BrowserPlugIn").Value}", "_blank"))">
                        <span>Скачать</span>
                    </div>
                </div>
            </div>
        </div>


    </div>
</section>

@code {
    // Информация о Крипто-Про и Плагина
    private Info _info = new Info() { PluginInfo = new Plugin(), CryptoProInfo = new CryptoPro() };

    /// <summary>
    /// Список установленных сертификатов
    /// </summary>
    private List<UserCertificate> _certificates = new();

    /// <summary>
    /// User-Agent (браузер)
    /// </summary>
    private string _agent = string.Empty;

    /// <summary>
    /// Текущий сертификат
    /// </summary>
    private UserCertificate _certificate = new UserCertificate();

    private bool _show = false;

    private ConnectionParameters? _connection;

    /// <summary>
    /// Результат обработки метода
    /// </summary>
    private Answer _answer = new(300, "");


    /// <summary>
    /// Содержимое модального окна
    /// </summary>
    private Comment _comment = new(false, string.Empty, string.Empty, string.Empty);


    protected override async Task OnInitializedAsync()
    {
    try
    {
        _connection = JsonSerializer.Deserialize<ConnectionParameters>((await _session.GetAsync<string>("Connection")).Value!);
    }
    catch
    {
        _navigator.NavigateTo("/");
        return;
    }

    _agent = await _jsr.InvokeAsync<string>("GetUserAgent");

    //Получаем данные о КриптоПро и сертификатах
    try
    {
        _answer = await _jsr.InvokeAsync<Answer>("GetCryptoProInfoAsync");

        if (!_answer.Code.Equals(200))
        {
            _comment = new(true, "error", "Диагностика", $"При получении данных о КриптоПро возникла ошибка: {_answer.Message}");
            return;
        }

        _info = JsonSerializer.Deserialize<Info>(_answer.Message) ?? new Info() { PluginInfo = new Plugin(), CryptoProInfo = new CryptoPro() };

        _answer = await _jsr.InvokeAsync<Answer>("GetListOfCertificateAsync");
    }
    catch (Exception _ex)
    {
        _comment = new(true, "error", "Диагностика", $"При получении данных о КриптоПро возникла ошибка: {_ex.Message}");
        return;
    }

    try
    {
        _answer = await _jsr.InvokeAsync<Answer>("GetListOfCertificateAsync");

        if (!_answer.Code.Equals(200))
        {
            _comment = new(true, "error", "Диагностика", $"При получении списка установленных сертификатов возникла ошибка: {_answer.Message}");
            return;
        }

        _certificates = JsonSerializer.Deserialize<List<UserCertificate>>(_answer.Message) ?? new();

    }
    catch (Exception _ex)
    {
        _comment = new(true, "error", "Диагностика", $"При получении списка установленных сертификатов возникла ошибка: {_ex.Message}");
        return;
    }

    }



}
