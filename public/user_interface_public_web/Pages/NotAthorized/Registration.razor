@layout NonAuthorizeLayout
@page "/registration"
@using System.ComponentModel.DataAnnotations

<PageTitle>Регистрация</PageTitle>

<CommentWindow InfoComment="_comment" />

<main class="main">
    <section class="registration">
        <form class="registration__form form">
            <div class="form__top">
                <div class="form__icon"> <img src="img/svg/user.svg" alt=""></div>
                <div class="form__title">Регистрация для Юридических лиц</div>
            </div>
            <div class="form__items">
                <div class="form__half form__item">
                    <div class="form__item-title">Учетная запись</div>
                    <div class="form__inputs">
                        <div class="form__input">
                            <div class="form__input-label">Ваш логин: *</div>
                            <input type="text" name="login" required @bind=_user.Login>
                        </div>
                        <div class="form__input">
                            <div class="form__input-label">Ваш пароль: *</div>
                            <input type="password" name="password" required @bind=_user.Password>
                        </div>
                        <div class="form__input">
                            <div class="form__input-label">Подтвердите пароль: *</div>
                            <input type="password" id="password_approve" name="password_approve" required @bind=_confirmation>
                        </div>
                        <div class="form__input">
                            <div class="form__input-label">Адрес электронной почты: *</div>
                            <input type="email" name="email" required @bind=_user.Email>
                        </div>
                    </div>
                </div>
                <div class="form__half form__item">
                    <div class="form__item-title">Пользователь</div>
                    <div class="form__inputs">
                        <div class="form__input">
                            <div class="form__input-label">Фамилия: *</div>
                            <input type="text" id="surname" name="second_name" required @bind=_user.LastName>
                        </div>
                        <div class="form__input">
                            <div class="form__input-label">Имя: *</div>
                            <input type="text" name="name" required @bind=_user.FirstName>
                        </div>
                        <div class="form__input">
                            <div class="form__input-label">Отчество: </div>
                            <input type="text" name="last_name" @bind=_user.MiddleName>
                        </div>
                        <div class="form__input">
                            <div class="form__input-label">Телефон: </div>
                            <input type="text" name="tel" data-format="0000000000" id="phone" @bind=_user.Phone>
                        </div>
                    </div>
                </div>
                <div class="form__half form__item">
                    <div class="form__item-title">Подтверждение</div>
                    <div class="form__inputs">
                        <div class="form__input">
                            <div class="form__input-label">Код регистрации: *</div>
                            <input type="text" name="code" id="accept" required @bind=_accept>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form__btns">
                <div class="form__btns-text">* Поля обязательные для заполнения  </div>
                <button type="button" class="form__btn btn btn--green" disabled="@_disabled" @onclick=RegistrationUserAsync>Регистрация</button>
            </div>
        </form>
    </section>
</main>

@code {
    /// <summary>
    /// Содержимое модального окна
    /// </summary>
    private Comment _comment = new(false, string.Empty, string.Empty, string.Empty);

    /// <summary>
    /// Данные пользователя
    /// </summary>
    private DBUser _user = new() { Login = string.Empty, Password = string.Empty, Email = string.Empty, };

    /// <summary>
    /// Подтверждение пароля
    /// </summary>
    private string _confirmation = string.Empty;

    /// <summary>
    /// Код подтверждения
    /// </summary>
    private string _accept = string.Empty;

    /// <summary>
    /// Доступность кнопки
    /// </summary>
    private bool _disabled = false;

    /// <summary>
    /// Ответ сервисов
    /// </summary>
    private Answer? _error = new Answer(0, string.Empty);

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        await _jsr.InvokeVoidAsync("mask");
    }


    /// <summary>
    /// Регистрация пользователя
    /// </summary>
    /// <returns></returns>
    private async Task RegistrationUserAsync()
    {
        _disabled = true;

        await Task.Delay(10);

        _error = _validator.Check(_user);

        if (!_error.Code.Equals(200))
        {
            _comment = new(true, "error", "Регистрация пользователя", _error.Message);
            _disabled = false;
            return;
        }

        if (!_user.Password.Equals(_confirmation))
        {
            _comment = new(true, "error", "Регистрация пользователя", "Пароли не совпадают");
            _disabled = false;
            return;
        }

        _error = await _userMngr.RegistrationAsync(_user, _accept);

        _comment = new(true, _error.Code.Equals(200) ? "ok" : "error", "Регистрация пользователя", _error.Message);

        if (_error.Code.Equals(200))
        {
            List<NotificationTo> _recipients = new();

            _recipients.AddRange(_configuration.GetSection("Support").Get<List<NotificationTo>>()!);

            EmailMessage _message = new()
                {
                    Body = $"В личном кабинете ООО \"БКИ КредитИнфо\" зарегистрирован новый пользователь {_user.Login} ({_user.Organization.ShortName}) и ожидает подтверждение учетной записи",
                    Subject = "Регистрация пользователя",
                    BodySubject = "Регистрация пользователя",
                    Sender = "noreply@bki-ci.ru",
                    Correspondents = _recipients.Select(r => new EmailCorrespondent() { CorrespondentName = r.UserName, Email = r.Email, SendingType = "to" }).ToList(),
                    TemplateName = "MailSimpleTpl"
                };

            _error = await _sender.SendEmailAsync(_message);
        }

        _disabled = false;
    }


}
