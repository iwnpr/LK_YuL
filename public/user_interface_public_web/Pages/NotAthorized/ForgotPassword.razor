@layout NonAuthorizeLayout
@page "/forgot_password"
@using System.Text.RegularExpressions

<PageTitle>Восстановление пароля</PageTitle>

<CommentWindow InfoComment="_comment" />

<div class="authorization__wrapper">
    <form class="authorization__form form">
        <div class="form__top">
            <div class="form__icon"><img src="img/svg/login.svg" alt=""></div>
            <div class="form__title">Восстановление учетных данных</div>
        </div>
        <div class="form__body">
            <div class="form__inputs">

                <div class="form__input">
                    <div class="form_restoration_input-label">Введите логин, который был указан при регистрации</div>
                    <input type="text" name="login" id="login" @bind=@_loginForRecovery required>
                </div>

                <div class="form__input">
                    <div class="form_restoration_input-label">Введите e-mail, который был указан при регистрации</div>
                    <input type="email" name="email" id="email" @bind=@_emailForRecovery required>
                </div>

            </div>
            <div class="form_restoration_btns">
                <button class="form_restoration_btn btn btn--green" type="button" disabled="@_disabled" @onclick="Authorization">Войти</button>
                <button class="form_restoration_btn btn btn--green" type="button" disabled="@_disabled" @onclick="RestoreAsync">Восстановить</button>
            </div>
        </div>
    </form>
    <div class="authorization__img">
        <picture>
            <source srcset="/img/authorization/men.webp" type="image/webp" />
            <source srcset="/img/authorization/men.png" type="image/png" /><img src="/img/authorization/men.png" alt="undefined" />
        </picture>
    </div>
</div>

@code {

    /// <summary>
    /// Содержимое модального окна
    /// </summary>
    private Comment _comment = new(false, string.Empty, string.Empty, string.Empty);

    private bool _disabled = false;
    private string RequiredOnValid = string.Empty;
    Answer? _error = new Answer(0, string.Empty);

    private string _emailForRecovery = string.Empty;
    private string _loginForRecovery = string.Empty;

    private void Authorization()
    {
        _navigator.NavigateTo("/");
    }

    private async Task RestoreAsync()
    {
        _disabled = true;
        await Task.Delay(1);

        if (string.IsNullOrEmpty(_loginForRecovery))
        {
            _comment = new(true, "error", "Регистрация пользователя", "Введен некорректный логин");
            _disabled = false;
            return;
    }

    if (!Regex.Match(_emailForRecovery, "[.\\-_a-z0-9]+@([a-z0-9][\\-a-z0-9]+\\.)+[a-z]{2,6}", RegexOptions.IgnoreCase).Success)
    {
        _comment = new(true, "error", "Регистрация пользователя", "Введен некорректный адрес электронной почты");
            _disabled = false;
        return;
    }

    _error = await _userMngr.RestorePasswordAsync(_loginForRecovery, _emailForRecovery);


    if (!_error.Code.Equals(200))
    {
        _comment = new(true, "error", "Восстановление пароля", _error.Message);
        _disabled = false;
        return;
    }

    EmailMessage _message = new()
        {
            Body = $"Сcылка для изменения пароля в личном кабинете ООО \"БКИ КредитИнфо\": <br> <div style=\"width:100%;text-align:center\"><a href=\"{_navigator.BaseUri}restore_password/{_error.Message}\" style=\"color:rgb(44, 181, 67);font-size:14px;text-decoration: underline; align:center\">Восстановить пароль</a></div><br>",
            Subject = "Восстановление пароля",
            BodySubject = "Восстановление пароля пользователя",
            Sender = "noreply@bki-ci.ru",
            Correspondents = new() { new() { CorrespondentName = "", Email = _emailForRecovery, SendingType = "to" } },
            TemplateName = "MailSimpleTpl"
        };

    _error = await _sender.SendEmailAsync(_message);

    if (!_error.Code.Equals(200))
    {
        _comment = new(true, "error", "Восстановление пароля", "Не удалось отправить сообщение на электронную почту");
        _disabled = false;
        return;
    }

    _comment = new(true, "ok", "Восстановление пароля", $"На электронную почту {_emailForRecovery} отправлена ссылка для восстановления пароля");

    _disabled = false;
    }
}