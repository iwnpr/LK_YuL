@layout NonAuthorizeLayout
@page "/restore_password/{Code}"

<PageTitle>Восстановление пароля</PageTitle>

<CommentWindow InfoComment="_comment" />

<div class="authorization__wrapper">
    <form class="authorization__form form">
        <div class="form__top">
            <div class="form__icon"><img src="img/svg/login.svg" alt=""></div>
            <div class="form__title">Восстановление пароля</div>
        </div>
        <div class="form__body">
            <div class="form__inputs">

                <div class="form__input">
                    <div class="form_restoration_input-label">Введите новый пароль</div>
                    <input type="password" name="password" id="password" @bind=@_password required>
                </div>

            </div>
            <div class="form__inputs">

                <div class="form__input">
                    <div class="form_restoration_input-label">Введите новый пароль еще раз</div>
                    <input type="password" name="confirm" id="confirm" @bind=@_confirm required>
                </div>

            </div>
            <div class="form_restoration_btns">
                <button class="form_restoration_btn btn btn--green" type="button" disabled="@_disabled" @onclick="@(() => _navigator.NavigateTo("/"))">Войти</button>
                <button class="form_restoration_btn btn btn--green" type="button" disabled="@_disabled" @onclick="RestoreAsync">Восстановить</button>
            </div>
        </div>
    </form>
    <div class="authorization__img">
        <picture>
            <source srcset="/img/authorization/men.webp" type="image/webp" />
            <source srcset="/img/authorization/men.png" type="image/png" /><img src="/img/authorization/men.png" alt="undefined" />
        </picture>
    </div>
</div>

@code {
    [Parameter] public string Code { get; set; } = string.Empty;

    /// <summary>
    /// Содержимое модального окна
    /// </summary>
    private Comment _comment = new(false, string.Empty, string.Empty, string.Empty);

    /// <summary>
    /// Доступность кнопки
    /// </summary>
    private bool _disabled = false;

    /// <summary>
    /// Пароль пользователя
    /// </summary>
    private string _password = string.Empty;

    /// <summary>
    /// Подтверждение пароля
    /// </summary>
    private string _confirm = string.Empty;

    /// <summary>
    /// Ответ от сервисов
    /// </summary>
    Answer? _error = new Answer(0, string.Empty);

    /// <summary>
    /// Инициализация параметров
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        //TODO проверка кода
        if (string.IsNullOrEmpty(Code) || !await _userMngr.CheckCodeAsync(Code))
        {
            _navigator.NavigateTo("404");
        }
    }

    /// <summary>
    /// Обновление пароля пользователя
    /// </summary>
    /// <returns></returns>
    private async Task RestoreAsync()
    {
        _disabled = true;

        if (!_password.Equals(_confirm))
        {
            _comment = new(true, "error", "Восстановление пароля", "Пароли не совпадают");
            _disabled = false;
            return;
        }

        _error = await _userMngr.RecoveryPasswordAsync(_password, Code);

        _comment = new(true, _error.Code.Equals(200) ? "ok" : "error", "Восстановление пароля", _error.Message);

        _disabled = false;
    }
}