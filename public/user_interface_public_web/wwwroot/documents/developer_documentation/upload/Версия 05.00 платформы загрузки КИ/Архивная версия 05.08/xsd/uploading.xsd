<?xml version="1.0" encoding="windows-1251"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified" version="4.0">
	<xs:element name="Document">
		<xs:annotation>
			<xs:documentation>
				<version>5.08</version>
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="source" type="tSource"/>
				<xs:element name="number_of_subjects" type="xs:nonNegativeInteger"/>		
				<xs:element name="number_of_blocks_group" type="xs:nonNegativeInteger"/>	
				<xs:element name="subject" type="tSubject" minOccurs="1" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="schema_version" type="tVersion" use="optional"/>
			<xs:attribute name="outgoing_date_time" type="tDateTime" use="required"/>
			<xs:attribute name="outgoing_reg_num" type="xs:string" use="required"/>
			<xs:attribute name="prev_outgoing_reg_num" type="xs:string" use="optional"/>
			<xs:attribute name="prev_outgoing_date_time" type="tDateTime" use="optional"/>		
		</xs:complexType>
	</xs:element>
	
	<xs:complexType name="tSource">
		<xs:sequence>
			<xs:element name="itn" type="xs:string"/>
			<xs:element name="psrn" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tSubject">
		<xs:sequence>
			<xs:element name="blocks_group" type="tBlocksGroup" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tBlocksGroup">
		<xs:sequence>
			<xs:element name="event">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="tEventCode">
							<xs:attribute name="event_date" type="tBirthDate" use="required"/>
							<xs:attribute name="start_date" type="tBirthDate" use="optional"/>	
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="operation" type="tOperation"/>
			<xs:choice>
				<xs:element name="add_individual" type="tAddIndividual"/>								<!--Титульная часть физ лица-->
				<xs:element name="add_legal_entity" type="tAddLegalEntity"/>							<!--Титульная часть юридического лица-->				
			</xs:choice>
			<xs:choice>
				<xs:element name="add_individual_changed" type="tAddIndividualChanged" minOccurs="0" maxOccurs="1"/>
				<xs:element name="add_legal_entity_changed" type="tAddLegalEntityChanged" minOccurs="0" maxOccurs="1"/>
			</xs:choice>
			<xs:element name="add_main" type="tAddMain" minOccurs="0" maxOccurs="1"/>									<!--Основная часть-->
			<xs:element name="add_main_changed" type="tAddMainChanged" minOccurs="0" maxOccurs="unbounded"/>			<!--Основная часть д/коррекции и аннуляции-->
			<xs:element name="add_private" type="tAddPrivate"/>															<!--Закрытая (дополнит) часть-->
			<xs:element name="add_private_changed" type="tAddPrivateChanged" minOccurs="0" maxOccurs="unbounded"/>		<!--Закрытая (дополнит) часть д/коррекции и аннуляции-->
			<xs:element name="add_info" type="tAddInfo" minOccurs="0" maxOccurs="1"/>									<!--Инф часть-->
			<xs:element name="add_info_changed" type="tAddInfoChanged" minOccurs="0" maxOccurs="unbounded"/>			<!--Инф часть д/коррекции и аннуляции-->
		</xs:sequence>
		<xs:attribute name="id" type="xs:string" use="required"/>
	</xs:complexType>
	
	<xs:complexType name="tOperation">
		<xs:sequence>
			<xs:element name="operation_code" type="tOperationCode"/>
			<xs:element name="comment" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	
	<!--
  ************************************************************************************************************************
	  MAIN LOGICAL TYPES
  ************************************************************************************************************************
-->
	<!--Титульная часть КИ ФЛ -->
	<xs:complexType name="tAddIndividual">
		<xs:sequence>
			<xs:element name="i_full_name" type="tFullName"/>										<!--блок 1-->
			<xs:element name="i_old_full_name" type="tOldFullName" maxOccurs="unbounded"/>			<!--блок 2-->
			<xs:element name="i_birth_date_place" type="tibDatePlace"/>								<!--блок 3-->
			<xs:element name="i_identity_doc" type="tIdentityDoc" maxOccurs="unbounded"/>			<!--блок 4-->
			<xs:element name="i_old_identity_doc" type="tOldIdentityDoc" maxOccurs="unbounded"/>	<!--блок 5-->
			<xs:element name="i_reg_num" type="tRegNum" minOccurs="0" maxOccurs="1"/>				<!--блок 6 -->
			<xs:element name="i_snils" type="tSNILS" minOccurs="0" maxOccurs="1"/>					<!--блок 7 -->
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tAddIndividualChanged">
		<xs:sequence>
			<xs:element name="i_full_name" type="tFullName" minOccurs="0"/>										<!--блок 1-->
			<xs:element name="i_old_full_name" type="tOldFullName" minOccurs="0" maxOccurs="unbounded"/>		<!--блок 2-->
			<xs:element name="i_birth_date_place" type="tibDatePlace" minOccurs="0"/>							<!--блок 3-->
			<xs:element name="i_identity_doc" type="tIdentityDoc" minOccurs="0" maxOccurs="unbounded"/>			<!--блок 4-->
			<xs:element name="i_old_identity_doc" type="tOldIdentityDoc" minOccurs="0" maxOccurs="unbounded"/>	<!--блок 5-->
			<xs:element name="i_reg_num" type="tRegNum" minOccurs="0" maxOccurs="1"/>							<!--блок 6 -->
			<xs:element name="i_snils" type="tSNILS" minOccurs="0" maxOccurs="1"/>								<!--блок 7 -->
		</xs:sequence>
	</xs:complexType>
	
	<!-- Блок 1-->
	<xs:complexType name="tFullName">
		<xs:sequence>
			<xs:element name="surname" type="StrUnlimName"/>
			<xs:element name="name" type="StrUnlimName"/>
			<xs:element name="patronymic" type="StrUnlimName" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<!-- Блок 2-->
	<xs:complexType name="tOldFullName">
		<xs:sequence>
			<xs:element name="i_full_name" type="tFullName" minOccurs="0" maxOccurs="1"/>
			<xs:element name="new_name_issue_date" type="tDate" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
		<xs:attribute name="old_name" type="tLogical" use="required"/>
	</xs:complexType>
	<!-- Блок 3-->
	<xs:complexType name="tibDatePlace">
		<xs:sequence>
			<xs:element name="birth_date" type="tBirthDate"/>
			<xs:element name="country_code" type="Str3"/>
			<xs:element name="birth_place" type="Str2000" minOccurs="0"/> 			<!--Изменена обязательность-->
		</xs:sequence>
	</xs:complexType>
	<!-- Блок 4-->
	<xs:complexType name="tIdentityDoc">
		<xs:sequence>
			<xs:element name="citizenship" type="tSitizenship"/>
			<xs:element name="identity_doc_data" type="tiIdentityDocData"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="tSitizenship">
		<xs:sequence>
			<xs:element name="country_code" type="Str3"/>
			<xs:element name="another_country_name" type="StrUnlimRusLat" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tiIdentityDocData">
		<xs:sequence>
			<xs:group ref="gIdentityDocData"/>
			<xs:element name="d_expired_date" type="tDate" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:group name="gIdentityDocData">
		<xs:sequence>
			<xs:element name="d_code" type="tDocCode"/>
			<xs:element name="d_other_name" type="StrUnlimComma" minOccurs="0" maxOccurs="1"/>
			<xs:element name="d_series" type="StrUnlimHyphen" minOccurs="0" maxOccurs="1"/>
			<xs:element name="d_number" type="xs:string"/>
			<xs:element name="d_issue_date" type="tDate"/>
			<xs:element name="d_authority" type="Str2000" minOccurs="0" maxOccurs="1"/>
			<xs:element name="d_department_code" type="tDepartmentCode" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:group>
	
	<!-- Блок 5-->
	<xs:complexType name="tOldIdentityDoc">
		<xs:sequence>
			<xs:element name="citizenship" type="tSitizenship" minOccurs="0"/>
			<xs:element name="identity_doc_data" type="tiIdentityDocData" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="old_identity_doc" type="tLogical" use="required"/>
	</xs:complexType>
	
	<!--Блок 6 -->
	<xs:complexType name="tRegNum">
		<xs:sequence>
			<xs:element name="i_itn" type="tInfoITN" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="i_psrn" type="tInfoSRN" minOccurs="0" maxOccurs="1"/>
			<xs:element name="special_tax_mode" type="tLogical" minOccurs="0"/>							
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="tInfoITN">
		<xs:sequence>
			<xs:element name="itn_code" type="tITNCode"/>
			<xs:element name="itn" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="tInfoSRN">
		<xs:sequence>
			<xs:element name="psrn_code" type="tPSRNCode"/>
			<xs:element name="psrn" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	
	<!--Блок 7-->
	<xs:simpleType name="tSNILS">
		<xs:restriction base="xs:string">
			<xs:pattern value="(\d{3}[-]\d{3}[-]\d{3}[\s]\d{2})|[-]"/>
		</xs:restriction>
	</xs:simpleType>
	<!--*************************************************************************************************************************-->
	<!--Титульная часть КИ ЮЛ -->
	<xs:complexType name="tAddLegalEntity">
		<xs:sequence>
			<xs:element name="le_name" type="tLeName"/>												<!--блок 1-->
			<xs:element name="le_address_and_contacts" type="tAddressAndContacts"/>					<!--блок 2-->
			<xs:element name="le_reg_num" type="tleRegNum" minOccurs="0" maxOccurs="1"/>			<!--блок 3-->
			<xs:element name="le_itn" type="tInfoITN" maxOccurs="unbounded"/>						<!--блок 4-->
			<xs:element name="le_reorganization" type="tReorganization" maxOccurs="unbounded"/>		<!--блок 5-->
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tAddLegalEntityChanged">
		<xs:sequence>
			<xs:element name="le_name" type="tLeName" minOccurs="0"/>													<!--блок 1-->
			<xs:element name="le_address_and_contacts" type="tAddressAndContacts" minOccurs="0"/>						<!--блок 2-->
			<xs:element name="le_reg_num" type="tleRegNum" minOccurs="0" maxOccurs="1"/>								<!--блок 3-->
			<xs:element name="le_itn" type="tInfoITN" minOccurs="0" maxOccurs="unbounded"/>								<!--блок 4-->
			<xs:element name="le_reorganization" type="tReorganization" minOccurs="0" maxOccurs="unbounded"/>			<!--блок 5-->
		</xs:sequence>
	</xs:complexType>
	<!--Блок 1 -->
	<xs:complexType name="tLeName">
		<xs:complexContent>
			<xs:extension base="tName">
				<xs:sequence>
					<xs:element name="name_changed" type="tLogical"/>												
					<xs:element name="old_full_name" type="Str2000" minOccurs="0" maxOccurs="1"/>					
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	
	<xs:complexType name="tName">
		<xs:sequence>
			<xs:element name="full_name" type="Str2000"/>
			<xs:element name="short_name" type="Str2000"/>
			<xs:element name="other_name" type="Str2000" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<!--Блок 2 -->
	<xs:complexType name="tAddressAndContacts">
		<xs:sequence>
			<xs:element name="le_address">
				<xs:complexType>
					<xs:group ref="gAddress"/>
				</xs:complexType>
			</xs:element>		
			<xs:element name="le_contacts" type="tContacts" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<!--Блок 3 -->
	<xs:complexType name="tleRegNum">
		<xs:sequence>
			<xs:element name="le_psrn" type="tInfoSRN" minOccurs="0" maxOccurs="1"/>
			<xs:element name="lei" type="tLEI" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<!--Блок 4-->
	<xs:complexType name="tleITN">
		<xs:sequence>
			<xs:element name="itn_code" type="tITNCode" minOccurs="0" maxOccurs="1"/>
			<xs:element name="itn" type="xs:string" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<!--Блок 5 -->
	<xs:complexType name="tReorganization">
		<xs:sequence>
			<xs:element name="reorganized" type="tLogical"/>
			<xs:element name="full_name" type="Str2000" minOccurs="0" maxOccurs="1"/>
			<xs:element name="short_name" type="Str2000" minOccurs="0" maxOccurs="1"/>
			<xs:element name="le_psrn" type="tInfoSRN" minOccurs="0" maxOccurs="1"/>
			<xs:element name="reorganization_date" type="tDate" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<!--Основная часть-->
	<xs:complexType name="tAddMain">
		<xs:sequence>
			<xs:element name="i_reg_address" type="tRegAddress" minOccurs="0" maxOccurs="1"/>										<!--блок 8-->
			<xs:element name="i_actual_address" type="tActualAddress" minOccurs="0" maxOccurs="1"/>									<!--блок 9-->
			<xs:element name="i_contacts" type="tContacts" minOccurs="0" maxOccurs="1"/>											<!--блок 10-->
			<xs:element name="i_individual_entrpreneur_reg" type="tIndividualEntrpreneurReg" minOccurs="0" maxOccurs="1"/>			<!--блок 11-->
			<xs:element name="i_legal_capacity" type="tLegalCapacity" minOccurs="0" maxOccurs="1"/>									<!---блок 12-->
			<xs:element name="bankruptcy" type="tBankruptcy" minOccurs="0" maxOccurs="1"/>											<!--блок 13 совп с блоком 6 у ЮЛ-->
			<xs:element name="obligation_excemption_because_of_bankruptcy" type="tObligationExcemption" minOccurs="0" maxOccurs="1"/>			<!--блок 14 совп с блоком 7 у ЮЛ-->
			<xs:element name="i_credit_rating" type="tCreditRating" minOccurs="0" maxOccurs="1"/>									<!--блок 15-->
			<!--<xs:element name="le_transferring_rights_and_obligations" type="tTransferringRightsObligation" minOccurs="0" maxOccurs="unbounded"/>	<!{1}**блок 8 у ЮЛ**{1}>-->
			<xs:element name="credit_score" type="tCreditScore" minOccurs="0" maxOccurs="1"/>										<!--блок 16 совп с блоком 9 у ЮЛ-->
			<xs:element name="deal_id" type="tDealId" minOccurs="0" maxOccurs="1"/>													<!--блок 17 совп с блоком 10 у ЮЛ-->
			<xs:element name="credit_deal" type="tCreditDeal" minOccurs="0" maxOccurs="1"/>											<!--Блок 18 совп с блоком 11 у ЮЛ-->
			<xs:element name="credit_sum" type="tCreditSum" minOccurs="0" maxOccurs="unbounded"/>									<!--Блок 19 совп с блоком 12 у ЮЛ-->
			<xs:element name="joint_debtor" type="tJointDebtor" minOccurs="0" maxOccurs="1"/>										<!--Блок 20 совп с блоком 13 у ЮЛ -->
			<xs:element name="payment_conditions" type="tPaymentConditions" minOccurs="0" maxOccurs="1"/>							<!--Блок 21 совп с блоком 14 у ЮЛ -->
			<xs:element name="i_credit_total_sum" type="tCreditTotalSum" minOccurs="0" maxOccurs="1"/>								<!--Блок 22 -->
			<xs:element name="credit_contract_change" type="tCreditContractChange" minOccurs="0" maxOccurs="unbounded"/>			<!--Блок 23 совп с блоком 15 ЮЛ-->
			<xs:element name="funding_transfer_info" type="tFundingTransferInfo" minOccurs="0" maxOccurs="unbounded"/>				<!--Блок 24 совп с блоком 16 ЮЛ-->
			<xs:element name="credit_debt" type="tCreditDebt" minOccurs="0" maxOccurs="1"/>											<!--Блок 25 совп с блоком 17 ЮЛ-->
			<xs:element name="credit_urgent_debt" type="tCreditUrgentDebt" minOccurs="0" maxOccurs="1"/>							<!--Блок 26 совп с блоком 18 ЮЛ -->
			<xs:element name="credit_overdue_debt" type="tCreditOverdueDebt" minOccurs="0" maxOccurs="1"/>							<!-- блок 27 совп с блоком 19 ЮЛ-->
			<xs:element name="making_payment" type="tMakingPayment" minOccurs="0" maxOccurs="1"/>									<!--Блок 28 совп с блоком 20 ЮЛ-->
			<xs:element name="i_amp" type="tAMP" minOccurs="0" maxOccurs="1"/>														<!--Блок 29-->
			<xs:element name="non-money_obligation_of_src" type="tObligationSrc" minOccurs="0" maxOccurs="unbounded"/>				<!--Блок 30 совп с блоком 21 ЮЛ -->
			<xs:element name="non-money_obligation_of_sub" type="tObligationSub" minOccurs="0" maxOccurs="unbounded"/>				<!--Блок 31 совп с блоком 22 ЮЛ-->
			<xs:element name="pledge" type="tPledge" minOccurs="0" maxOccurs="unbounded"/>											<!--Блок 32 совп с блоком 23 ЮЛ -->
			<xs:element name="surety" type="tSurety" minOccurs="0" maxOccurs="unbounded"/>											<!--Блок 33 совп с блоком 24 ЮЛ-->
			<xs:element name="independent_guarantee" type="tIndependentGuarantee" minOccurs="0" maxOccurs="unbounded"/>				<!--Блок 34 совп с блоком 25 ЮЛ-->
			<xs:element name="insurance_of_pledge_subject" type="tInsurancePS" minOccurs="0" maxOccurs="unbounded"/>				<!--Блок 35 совп с блоком 26 ЮЛ-->
			<xs:element name="obligation_repayment_against_pledge" type="tObligationRepayment" minOccurs="0" maxOccurs="1"/>		<!--Блок 36 совп с блоком 27 ЮЛ-->
			<xs:element name="paid_sum_reimbursement" type="tPaidSumReimbursement" minOccurs="0" maxOccurs="1"/>					<!--Блок 37 совп с блоком 28 ЮЛ-->
			<xs:element name="obligation_termination" type="tObligationTerm" minOccurs="0" maxOccurs="1"/>							<!--Блок 38 совп с блоком 29 ЮЛ-->
			<xs:element name="litigation" type="tLitigation" minOccurs="0" maxOccurs="unbounded"/>									<!--Блок 39 совп с блоком 30 ЮЛ-->
			<xs:element name="i_amp_qcb" type="tAMPQCB" minOccurs="0" maxOccurs="1"/>												<!--Блок 40-->
			<xs:element name="bankruptcy_proceedings" type="tSourceLiquidation" minOccurs="0" maxOccurs="1"/>						<!-- Блок 41 совп с блоком 31 ЮЛ-->
			<xs:element name="source_liquidation" type="tSourceLiquidation" minOccurs="0" maxOccurs="1"/>							<!--Блок 42 совп с блоком 32 ЮЛ-->
			<xs:element name="debt_collection" type="tDebtCollection" minOccurs="0" maxOccurs="1"/>									<!--Блок 43 совп с блоком 33 ЮЛ-->
		<!-- 	<xs:element name="obligation_info_request" type="tObligationRequest" minOccurs="0" maxOccurs="1"/>						Блок 44 совп с блоком 34 ЮЛ-->
			<xs:element name="obligation_info_transfer_termination" type="tTransferTermination" minOccurs="0" maxOccurs="1"/>		<!--Блок 45 совп с блоком 35 ЮЛ-->
		</xs:sequence>
	</xs:complexType>
	
	<!--Основная часть измененная-->
	<xs:complexType name="tAddMainChanged">
		<xs:sequence>
			<xs:element name="i_reg_address" type="tRegAddress" minOccurs="0" maxOccurs="1"/>										<!--блок 8-->
			<xs:element name="i_actual_address" type="tActualAddress" minOccurs="0" maxOccurs="1"/>									<!--блок 9-->
			<xs:element name="i_contacts" type="tContacts" minOccurs="0" maxOccurs="1"/>											<!--блок 10-->
			<xs:element name="i_individual_entrpreneur_reg" type="tIndividualEntrpreneurReg" minOccurs="0" maxOccurs="1"/>			<!--блок 11-->
			<xs:element name="i_legal_capacity" type="tLegalCapacity" minOccurs="0" maxOccurs="1"/>									<!---блок 12-->
			<xs:element name="bankruptcy" type="tBankruptcy" minOccurs="0" maxOccurs="1"/>											<!--блок 13 совп с блоком 6 у ЮЛ-->
			<xs:element name="obligation_excemption_because_of_bankruptcy" type="tObligationExcemption" minOccurs="0" maxOccurs="1"/>			<!--блок 14 совп с блоком 7 у ЮЛ-->
			<xs:element name="i_credit_rating" type="tCreditRating" minOccurs="0" maxOccurs="1"/>									<!--блок 15-->
			<!--<xs:element name="le_transferring_rights_and_obligations" type="tTransferringRightsObligation" minOccurs="0" maxOccurs="unbounded"/>	<!{1}**блок 8 у ЮЛ**{1}>-->
			<xs:element name="credit_score" type="tCreditScore" minOccurs="0" maxOccurs="1"/>										<!--блок 16 совп с блоком 9 у ЮЛ-->
			<xs:element name="deal_id" type="tDealId" minOccurs="0"/>																<!--блок 17 совп с блоком 10 у ЮЛ-->
			<xs:element name="credit_deal" type="tCreditDeal" minOccurs="0" maxOccurs="1"/>											<!--Блок 18 совп с блоком 11 у ЮЛ-->
			<xs:element name="credit_sum" type="tCreditSum" minOccurs="0" maxOccurs="unbounded"/>									<!--Блок 19 совп с блоком 12 у ЮЛ-->
			<xs:element name="joint_debtor" type="tJointDebtor" minOccurs="0" maxOccurs="1"/>										<!--Блок 20 совп с блоком 13 у ЮЛ -->
			<xs:element name="payment_conditions" type="tPaymentConditions" minOccurs="0" maxOccurs="1"/>							<!--Блок 21 совп с блоком 14 у ЮЛ -->
			<xs:element name="i_credit_total_sum" type="tCreditTotalSum" minOccurs="0" maxOccurs="1"/> 								<!--Блок 22 -->
			<xs:element name="credit_contract_change" type="tCreditContractChange" minOccurs="0" maxOccurs="unbounded"/>			<!--Блок 23 совп с блоком 15 ЮЛ-->
			<xs:element name="funding_transfer_info" type="tFundingTransferInfo" minOccurs="0" maxOccurs="unbounded"/>				<!--Блок 24 совп с блоком 16 ЮЛ-->
