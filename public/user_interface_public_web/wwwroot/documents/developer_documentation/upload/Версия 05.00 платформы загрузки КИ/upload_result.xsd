	<xs:complexType name="tError">
		<xs:sequence>
			<!--<xs:element name="error_code" type="tErrorCode"/>-->
			<xs:element name="param_name" type="xs:string" minOccurs="0"/> 
			<xs:element name="param_path" type="xs:string" minOccurs="0"/> 
			<xs:element name="param_description" type="xs:string" minOccurs="0"/> 
			<xs:element name="add_explanation" type="xs:string" minOccurs="0"/> 
		</xs:sequence>
		<xs:attribute name="code" type="tErrorCode" use="required"/>
		<xs:attribute name="description" type="xs:string" use="required"/>
	</xs:complexType>
	
	<xs:simpleType name="tVersion">
		<xs:restriction base="xs:decimal">
			<xs:pattern value="\d{2}[.]\d{2}"/>
		</xs:restriction>
	</xs:simpleType>
	 
