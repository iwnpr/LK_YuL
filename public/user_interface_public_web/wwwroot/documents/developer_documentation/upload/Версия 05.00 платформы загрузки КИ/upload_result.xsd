<?xml version="1.0" encoding="windows-1251"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="upload_results">
		<xs:annotation>
			<xs:documentation>Извещение о принятии/непринятии кредитной информации</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="upload_result" type="tUploadResult" minOccurs="1" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:complexType name="tUploadResult">
		<xs:sequence>
			<xs:element name="code" type="tUploadCode"/>
			<xs:element name="in_doc_data" type="tDocData"/>
			<xs:element name="out_doc_data" type="tDocData"/>
			<xs:element name="reg_date_time" type="tDateTime"/>
			<xs:element name="number_of_subjects" type="xs:integer"/>
			<xs:element name="number_of_blocks_group" type="xs:integer"/>
			<xs:element name="flc_results" type="tFLCResults" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
		<xs:attribute name="file_name" type="xs:string" use="required"/>
		<xs:attribute name="schema_version" type="tVersion" use="required"/>
	</xs:complexType>
	
	<xs:simpleType name="tUploadCode">
		<xs:restriction base="xs:integer">
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
		</xs:restriction>
	</xs:simpleType>
	
	<xs:complexType name="tDocData">
		<xs:sequence>
			<xs:element name="reg_num" type="xs:string"/>
			<xs:element name="date_time" type="tDateTime"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:simpleType name="tDateTime">
		<xs:restriction base="xs:string">
			<xs:pattern value="\d{2}[.]\d{2}[.]\d{4}[ ]\d{2}[:]\d{2}[:]\d{2}"/>
		</xs:restriction>
	</xs:simpleType>
	
	<xs:complexType name="tFLCResults">
		<xs:sequence>
			<xs:element name="blocks_group" type="tBlocksGroup" minOccurs="1" maxOccurs="unbounded"/> 
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tBlocksGroup">
		<xs:sequence>
			<!--<xs:element name="error_list" type="tErrorList"/> -->
			<xs:element name="error" type="tError" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="num" type="xs:integer"/>
		<xs:attribute name="id" type="xs:string"/>
		<xs:attribute name="uid" type="xs:string"/>
	</xs:complexType>	
	
	<!--<xs:complexType name="tErrorList">
		<xs:sequence>
