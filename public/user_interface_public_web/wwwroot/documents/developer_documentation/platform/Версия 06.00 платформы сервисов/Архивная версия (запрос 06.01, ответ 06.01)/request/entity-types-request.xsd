	  <!-- '1' - запрос информации по юридическому лицу - работодателю субъекта (физического лица), представленному в первом по порядку следования теге «Employer» -->
	  <!-- '2' - запрос информации по всем юридическим лицам - работодателям субъекта (физического лица) -->
	  <!-- '3' - запрос информации по субъекту - юридическиму лицу -->
	  <!-- '4' - запрос информации по субъекту - юридическиму лицу или по юридическому лицу - работодателю субъекта (физического лица)-->
		</xs:restriction>
	<!-- Составляющие запроса информации по юридическим лицам в ФНС России -->
	</xs:simpleType>

