          <xs:sequence>
            <xs:element name="IncapacityCourtInfo" type="tCourtInfo" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:attribute name="Status" type="xs:integer" use="required"/>
          <xs:attribute name="ActualityDate" type="tDate"/>
          <xs:attribute name="CreationDate" type="tDate"/>
          <xs:attribute name="OwnerID" type="xs:integer"/>
        </xs:complexType>
      </xs:element>
      
