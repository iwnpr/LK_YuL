  <xs:complexType name="tReport">
    <xs:sequence>
      <xs:element name="TitlePart" type="tTitlePart"/>
      <xs:element name="MainPart" type="tMainPart" minOccurs="0"/>
	  <xs:element name="InformationalPart" type="tInformationalPart" minOccurs="0"/>
      <!--<xs:element name="InformationalPartOld" type="tInformationalPartOld" minOccurs="0"/>-->
	  <xs:element name="AdditionalPart" type="tAdditionalPart" minOccurs="0"/>
      <xs:element name="ReportSummary" type="tReportSummary" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="tTitlePart">
    <xs:choice>
      <xs:element name="NaturalPersonSubject">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Title" type="tPersonTitle" maxOccurs="unbounded"/>
            <xs:element name="PersonalInformation" type="tPersonalInformation" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="IdentificationDocument" type="tNaturalPersonIdentificationDocumentInfo" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
	  
      <xs:element name="LegalPersonSubject">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Title" type="tLegalTitleExt" maxOccurs="unbounded"/>
			<xs:element name="RestructuredTitle" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="tLegalTitleExt">
							<xs:attribute name="IsNameChangedFlag" type="xs:boolean"/>
							<xs:attribute name="ReorganizationDate" type="tDate"/>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
            <xs:element name="AddressInfo" type="tLegalAddressInfo" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="AddressOld" type="tAddressInfoOld" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Phone" type="tPhoneInfo" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="EMail" type="tEMail" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="tPersonalInformation">
    <xs:attribute name="IndividualTaxpayerNumber" type="tITN"/>
	<xs:attribute name="ForeignTaxpayerNumber" type="tStr50"/>
	<xs:attribute name="SpecialTaxMode" type="tBinaryFlag"/>			<!--New-->
	<xs:attribute name="PSRN" type="tPSRN"/>
	<xs:attribute name="ForeignRegNumber" type="tStr1000"/>
    <xs:attribute name="PensionNumber" type="tStr15"/>
    <xs:attribute name="BirthPlace" type="tStr1000"/>
	<xs:attribute name="BirthCountryCode" type="tNumStr3"/>
	<xs:attribute name="BirthCountryName" type="xs:string"/>													 
    <xs:attribute name="ActualityDate" type="tDate"/>
    <xs:attribute name="CreationDate" type="tDate"/>
    <xs:attribute name="OwnerID" type="xs:integer"/>
  </xs:complexType>

  <xs:complexType name="tPersonTitle">
    <xs:attribute name="LastName" type="tStr60" use="required"/>
    <xs:attribute name="FirstName" type="tStr60" use="required"/>
    <xs:attribute name="MiddleName" type="tStr60"/>
    <xs:attribute name="isOldName" type="xs:boolean"/>
	<xs:attribute name="DateOfDocWChangedName" type="tDate"/>
    <xs:attribute name="BirthDate" type="tDate" use="required"/>
    <xs:attribute name="ActualityDate" type="tDate"/>
    <xs:attribute name="CreationDate" type="tDate"/>
    <xs:attribute name="OwnerID" type="xs:integer"/>
  </xs:complexType>

  <xs:complexType name="tLegalTitleExt">
    <xs:all>
      <xs:element name="Name" type="tLegalName" minOccurs="0"/>
      <xs:element name="IndividualTaxpayerNumber" type="tITN" minOccurs="0"/>
      <xs:element name="PrimaryStateRegistrationNumber" type="tPSRN" minOccurs="0"/>
      <xs:element name="ForeignID" type="tStr50" minOccurs="0"/>
	  <xs:element name="ForeignRegNumber" type="tStr1000" minOccurs="0"/>
	  <xs:element name="LEI" type="tStr50" minOccurs="0"/>
    </xs:all>
    <xs:attribute name="ActualityDate" type="tDate"/>
    <xs:attribute name="CreationDate" type="tDate"/>
    <xs:attribute name="OwnerID" type="xs:integer"/>
  </xs:complexType>

  <xs:complexType name="tMainPart">
    <xs:sequence>
      <xs:element name="AddressInfo" type="tAddressInfo" minOccurs="0" maxOccurs="unbounded"/>
