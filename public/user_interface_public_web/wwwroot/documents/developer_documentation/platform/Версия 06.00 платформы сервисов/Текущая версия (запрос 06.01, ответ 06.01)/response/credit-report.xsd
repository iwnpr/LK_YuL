			<xs:attribute name="StageCode" type="xs:integer" use="required"/>
			<xs:attribute name="CaseDate" type="tDate"/>
			<xs:attribute name="PublicationLink" type="tLink"/>
			<xs:attribute name="IllegalActions" type="tBinaryFlag" use="required"/>
			<xs:attribute name="IllegalActionsDate" type="tDate"/>
			<xs:attribute name="FictitiousBankruptcy" type="tBinaryFlag" use="required"/>
			<xs:attribute name="FictitiousBankruptcyDate" type="tDate"/>
			<xs:attribute name="AdditionalInfo" type="xs:string"/>
			<xs:attribute name="ActualityDate" type="tDate"/>
			<xs:attribute name="CreationDate" type="tDate"/>
			<xs:attribute name="OwnerID" type="xs:integer"/>
		</xs:complexType>
	  </xs:element>
	  
