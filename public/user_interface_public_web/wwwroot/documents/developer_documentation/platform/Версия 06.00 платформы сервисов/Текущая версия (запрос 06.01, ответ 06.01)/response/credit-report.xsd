	  <xs:element name="EMail" type="tEMail" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="IndividualEntrepreneur" type="tIndividualEntrepreneurInfo" minOccurs="0" maxOccurs="unbounded"/>
      
	  <xs:element name="Incapacity" minOccurs="0" maxOccurs="unbounded">
