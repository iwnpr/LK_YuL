<?xml version="1.0" encoding="windows-1251"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified" version="2.1">

	<xs:complexType name="tREQUEST">
		<xs:sequence>
			<xs:element name="HEADER" type="tRequestHEADER"/>
			<xs:element name="BODY" type="tRequestBODY"/>
		</xs:sequence>
		<xs:attribute name="version" type="tVersion" use="required"/>
	</xs:complexType>

	<xs:simpleType name="tVersion">
		<xs:restriction base="xs:string">
			<xs:minLength value="5"/>
			<xs:maxLength value="5"/>
			<xs:pattern value="\d{2}[.]\d{2}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="tRequestHEADER">
		<xs:sequence>
			<!--<xs:element name="UserID" type="tUserID"/>
			<xs:element name="UserDescription" type="tUserDescription"/>
			<xs:element name="UserNaturalPerson" type="tUserNaturalPerson" minOccurs="0"/>-->
			<xs:element name="user" type="tUser"/>
			<!--<xs:element name="RequestDate" type="tDate" minOccurs="0"/>-->
			<xs:element name="request_date" type="tDate"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tUser">
		<xs:sequence>
			<xs:element name="user_id" type="xs:integer"/>
			<xs:element name="external_id" type="tStr255" minOccurs="0"/>
			<xs:element name="user_code" type="tUserCode"/>
			<xs:choice>
				<xs:element name="user_legal_entity" type="tUserLegalEntity"/>
				<xs:element name="user_natural_person" type="tUserNaturalPerson"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tUserLegalEntity">
		<xs:sequence>
			<xs:element name="registered_in_rf" type="tLogical"/>
			<xs:element name="user_name" type="tName"/>
			<xs:element name="user_psrn" type="tInfoSRN"/>	
			<xs:element name="lei" type="tLEI" minOccurs="0"/>			
			<xs:element name="user_itn" type="tInfoITN" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tName">
		<xs:sequence>
			<xs:element name="full_name" type="tStr2000"/>
			<xs:element name="short_name" type="tStr2000" minOccurs="0"/>			
			<xs:element name="other_name" type="tStr2000" minOccurs="0"/>			
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tInfoSRN">
		<xs:sequence>
			<xs:element name="psrn_code" type="tPSRNCode"/>
			<xs:element name="psrn" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tInfoITN">
		<xs:sequence>
			<xs:element name="itn_code" type="tITNCode"/>
			<xs:element name="itn" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>

	<!--<xs:complexType name="tUserID">
		<xs:simpleContent>
			<xs:extension base="xs:integer">
				<xs:attribute name="ExternalID" type="tStr255"/>
				<xs:attribute name="UserType" type="xs:integer" use="required"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>-->
  
	<!--<xs:complexType name="tUserDescription">
		<xs:simpleContent>
			<xs:extension base="tStr255">
				<xs:attribute name="UserPSRN" type="tPSRN"/>
				<xs:attribute name="UserRN" type="tStr20"/>
				<xs:attribute name="UserITN" type="tITN"/>
				<xs:attribute name="UserTN" type="tStr20"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>-->
  
	<xs:complexType name="tUserNaturalPerson">
		<xs:sequence>
			<xs:element name="user_name" type="tFullName"/>
			<xs:element name="birth_date" type="tDate"/>
			<xs:element name="birth_place" type="tStr2000"/>
			<xs:element name="user_identity_doc" type="tUserIdentityDoc"/>
			<xs:element name="user_psrn" type="tInfoSRN"/>		
			<xs:element name="user_itn" type="tInfoITN" maxOccurs="unbounded"/>		
			<xs:element name="user_snils" type="tSNILS"/>		
		</xs:sequence>
		<!--<xs:attribute name="LastName" type="tStr60" use="required"/>
		<xs:attribute name="FirstName" type="tStr60" use="required"/>
		<xs:attribute name="MiddleName" type="tStr60"/>
		<xs:attribute name="DocTypeID" type="xs:decimal" use="required"/>
		<xs:attribute name="DocSer" type="tStr20" use="required"/>
		<xs:attribute name="DocNum" type="tStr30" use="required"/>
		<xs:attribute name="DocDate" type="tDate" use="required"/>
		<xs:attribute name="PSRNIP" type="tPSRN" use="required"/>-->
	</xs:complexType>
	
	<xs:complexType name="tFullName">
		<xs:sequence>
			<xs:element name="surname" type="tStrUnlimName"/>
			<xs:element name="name" type="tStrUnlimName"/>
			<xs:element name="patronymic" type="tStrUnlimRusLat" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tUserIdentityDoc">
		<xs:sequence>
			<xs:group ref="gIdentityDocData"/>
			<xs:element name="d_authority" type="tStr2000"/>
			<xs:element name="d_department_code" type="tDepartmentCode" minOccurs="0" maxOccurs="1"/>		
		</xs:sequence>
	</xs:complexType>
	
	<xs:group name="gIdentityDocData">
		<xs:sequence>
			<xs:element name="d_code" type="tDocCode"/>
			<xs:element name="d_other_name" type="tStr2000" minOccurs="0" maxOccurs="1"/>
			<xs:element name="d_series" type="tStrUnlimHyphen" minOccurs="0" maxOccurs="1"/>
			<xs:element name="d_number" type="xs:string"/>
			<xs:element name="d_issue_date" type="tDate"/>
		</xs:sequence>
	</xs:group>

	<xs:complexType name="tRequestBODY">
		<xs:sequence>
			<xs:element name="RequestAttributes" type="tRequestAttributes"/>
			<xs:group ref="gRequestEntities"/>
		</xs:sequence>
	</xs:complexType>

	<xs:group name="gRequestEntities">
		<xs:choice>
			<xs:element name="NaturalPersonSubject" type="tNaturalPersonSubject" />
			<xs:element name="LegalPersonSubject" type="tLegalPerson"/>
			<xs:element name="Document" type="tNaturalPersonIdentificationDocument"/>
			<xs:element name="Address" type="tAddress"/>
			<xs:element name="Phone" type="tPhone"/>
			<xs:element name="Receipt" type="tReceipt"/>	<!--NEW-->
		</xs:choice>
	</xs:group>

	<xs:complexType name="tRequestAttributes">
		<xs:sequence>
			<xs:element name="ResponseCapabilities" type="tResponseCapabilities" minOccurs="0"/>
			<xs:element name="Reason" minOccurs="0">
			<xs:complexType>
				<xs:all>
					<xs:element name="SalesChannel" minOccurs="0" maxOccurs="1">
						<xs:complexType>
							<xs:simpleContent>
								<xs:extension base="tStr255">
									<xs:attribute name="type" type="tSalesChannel" use="required"/>
								</xs:extension>
							</xs:simpleContent>
						</xs:complexType>
					</xs:element>
					<xs:element name="ApplicationType" minOccurs="0" maxOccurs="1">
						<xs:complexType>
							<xs:simpleContent>
								<xs:extension base="tStr255">
									<xs:attribute name="type" type="tApplication" use="required"/>
								</xs:extension>
							</xs:simpleContent>	
						</xs:complexType>
					</xs:element>
					<xs:element name="ApplicationOrigin" minOccurs="0" maxOccurs="1">
						<xs:complexType>
							<xs:simpleContent>
								<xs:extension base="tStr255">
									<xs:attribute name="type" type="tApplicationOrigin" use="required"/>
								</xs:extension>
							</xs:simpleContent>	
						</xs:complexType>
					</xs:element>
					<xs:element name="ApplicationCollateral" minOccurs="0" maxOccurs="1">
						<xs:complexType>
							<xs:all>
								<xs:element name="Income" minOccurs="0">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="Period" maxOccurs="1">
												<xs:complexType>
													<xs:simpleContent>
														<xs:extension base="tStr255">
															<xs:attribute name="type" type="tPeriod" use="required"/>
														</xs:extension>
													</xs:simpleContent>
												</xs:complexType>
											</xs:element>
											<xs:element name="ConfirmationDocument" minOccurs="0" maxOccurs="unbounded">
												<xs:complexType>
													<xs:simpleContent>
														<xs:extension base="tStr255">
															<xs:attribute name="type" type="tIncomeConfirmationDocument" use="required"/>
														</xs:extension>
													</xs:simpleContent>
												</xs:complexType>
											</xs:element>
										</xs:sequence>
										<xs:attribute name="Amount" type="xs:decimal" use="required"/>
										<xs:attribute name="CurrencyID" type="xs:integer" use="required"/>
									</xs:complexType>
								</xs:element>
								<xs:element name="Property" minOccurs="0" maxOccurs="1">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="Car" minOccurs="0" maxOccurs="unbounded">
												<xs:complexType>
													<xs:sequence>
														<xs:element name="ConfirmationDocument" minOccurs="0" maxOccurs="unbounded">
															<xs:complexType>
																<xs:simpleContent>
																	<xs:extension base="tStr255">
																		<xs:attribute name="type" type="tCarConfirmationDocument" use="required"/>
																	</xs:extension>
																</xs:simpleContent>
															</xs:complexType>
														</xs:element>
													</xs:sequence>
													<xs:attribute name="BrandAndModel" type="tStr255"/>
													<xs:attribute name="CreationYear" type="xs:integer"/>
													<xs:attribute name="VIN" type="tStr50"/>
													<xs:attribute name="RegistrationNumber" type="tStr15"/>
												</xs:complexType>
											</xs:element>
											<xs:element name="Realty" minOccurs="0" maxOccurs="unbounded">
												<xs:complexType>
													<xs:sequence>
														<xs:element name="ConfirmationDocument" minOccurs="0" maxOccurs="unbounded">
															<xs:complexType>
																<xs:simpleContent>
																	<xs:extension base="tStr255">
																		<xs:attribute name="type" type="tRealtyConfirmationDocument" use="required"/>
																	</xs:extension>
																</xs:simpleContent>
															</xs:complexType>
														</xs:element>
													</xs:sequence>
													<xs:attribute name="type" type="tRealty" use="required"/>
													<xs:attribute name="description" type="tStr255"/>
												</xs:complexType>
											</xs:element>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
								<xs:element name="WorkExperience" minOccurs="0" maxOccurs="1">
									<xs:complexType>
										<xs:attribute name="NumberOfYears" type="xs:integer" use="required"/>
									</xs:complexType>
								</xs:element>
							</xs:all>
						</xs:complexType>
					</xs:element>
				</xs:all>
				<xs:attribute name="CustomerClaimCreditLimit" type="xs:decimal"/>
				<xs:attribute name="MontlyPaymentAmount" type="xs:decimal"/>
				<xs:attribute name="CurrencyID" type="xs:integer"/>
				<xs:attribute name="CurrencyCaption" type="tStr5"/>
				<!--<xs:attributeGroup ref="agTextID"/>-->
				<xs:attribute name="ID" type="tCreditTypeCode" use="required"/>
				<xs:attribute name="Text" type="tStr255"/>
			</xs:complexType>
			</xs:element>
			<xs:element name="RequestPurpose" type="tReference0" maxOccurs="unbounded"/>
			<xs:element name="Consent"  type="tConsent" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="id" type="xs:integer"/>
	</xs:complexType>

	<xs:complexType name="tNaturalPersonSubject">
		<xs:sequence>
			<xs:element name="Title" type="tNaturalPersonTitle" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="IdentificationDocument" type="tNaturalPersonIdentificationDocument" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="IndividualEntrepreneur" type="tIndividualEntrepreneur" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Address" type="tAddressWithUseExtension" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Phone" type="tPhoneWithConfirmationExtension" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="PersonalInternetPage" type="tUrl" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="EMail" type="tEMail" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Employer" type="tLegalPerson" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attributeGroup ref="agNaturalPersonID"/>
		<xs:attribute name="Gender" type="tGender"/>
		<xs:attribute name="MaritalStatus" type="tMaritalStatus"/>
		<xs:attribute name="Education" type="tEducation"/>
		<xs:attribute name="Children" type="tChildren"/>
		<xs:attribute name="CitizenshipCountryCode" type="tStr3" use="required"/>		
	</xs:complexType>

	<xs:attributeGroup name="agNaturalPersonID">
		<xs:attribute name="BirthDate" type="tDate"/>
		<xs:attribute name="BirthPlace" type="tStr1000"/>
		<xs:attribute name="IndividualTaxpayerNumber" type="tITN"/>
		<xs:attribute name="TaxpayerNumber" type="tStr20"/>
		<xs:attribute name="PensionNumber" type="tStr15"/>
	</xs:attributeGroup>

	<xs:complexType name="tNaturalPersonTitle">
		<xs:attribute name="LastName" type="tStr60" use="required"/>
		<xs:attribute name="FirstName" type="tStr60" use="required"/>
		<xs:attribute name="MiddleName" type="tStr60"/>
		<xs:attribute name="isOldName" type="xs:boolean"/>
		<xs:attribute name="ActualityDate" type="tDate"/>
	</xs:complexType>

	<xs:complexType name="tNaturalPersonIdentificationDocument">
		<xs:attribute name="DocTypeID" type="tDocCode" use="required"/>
		<xs:attribute name="DocTypeText" type="tStr1000"/>
		<xs:attribute name="DocSer" type="tStr20"/>
		<xs:attribute name="DocNum" type="tStr30" use="required"/>
		<xs:attribute name="DocDate" type="tDate" use="required"/>
		<xs:attribute name="DocPlace">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="300"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="DocDelivInstName" type="tStr500"/>
		<xs:attribute name="DocDelivInstCode" type="tStr50"/>
		<xs:attribute name="isOldDocument" type="xs:boolean"/>
	</xs:complexType>

	<xs:complexType name="tIndividualEntrepreneur">
		<xs:attribute name="PSRN" type="tPSRN" />
		<xs:attribute name="RegDate" type="tDate" />
		<xs:attribute name="RegData" type="tStr255"/>
	</xs:complexType>

	<xs:complexType name="tLegalPerson">
		<xs:sequence>
			<xs:element name="Title" type="tLegalTitle"/>
			<xs:element name="eMail" type="tEMailAddress" minOccurs="0"/>
			<xs:element name="www" type="tUrlAddress" minOccurs="0"/>
			<xs:element name="RestructuredTitle" type="tLegalTitle" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Address" type="tAddress" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Phone" type="tPhone" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="CountryCode" type="tStr3" use="required"/>			
	</xs:complexType>

	<xs:complexType name="tLegalTitle">
		<xs:sequence>
			<xs:element name="Name" type="tLegalName" minOccurs="0"/>
			<xs:group ref="tLegalItn"/>
			<xs:element name="PrimaryStateRegistrationNumber" type="tPSRN" minOccurs="0"/>
			<xs:element name="RegistrationNumber" type="tStr20" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<xs:group name="tLegalItn">
		<xs:choice>
			<xs:element name="IndividualTaxpayerNumber" type="tITN"/>
			<xs:element name="ForeignID" type="tStr50"/>
		</xs:choice>
	</xs:group>

	<xs:complexType name="tLegalName">
		<xs:attribute name="FullName" type="tStr1000" use="required"/>
		<xs:attribute name="ShortName" type="tStr255"/>
		<xs:attribute name="FirmName" type="tStr255"/>
		<xs:attribute name="NationalName" type="tStr1000"/>
		<xs:attribute name="EngName" type="tStr1000"/>
	</xs:complexType>

	<xs:complexType name="tAddress">
		<xs:sequence>
			<xs:element name="Caption" type="tCaption" minOccurs="0" maxOccurs="unbounded"/>
			<!--<xs:element name="Region" type="tCaption"/>-->
			<xs:element name="Region" type="tRegion"/>					
			<!--<xs:element name="District" type="tAddressIdentity" minOccurs="0"/>-->
			<xs:element name="District" type="tDistrict" minOccurs="0"/>
			<!--<xs:element name="City" type="tAddressIdentity" minOccurs="0"/>-->
			<xs:element name="City" type="tCity" minOccurs="0"/>
			<!--<xs:element name="Village" type="tAddressIdentity" minOccurs="0"/>-->
			<xs:element name="Village" type="tVillage" minOccurs="0"/>
			<xs:element name="StreetAddress" type="tStreetAddress" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tAddressEntity">
		<xs:sequence>
			<!--<xs:element name="Region" type="tCaption"/>-->
			<xs:element name="Region" type="tRegion"/>
			<!--<xs:element name="District" type="tAddressIdentity" minOccurs="0"/>-->
			<xs:element name="District" type="tDistrict" minOccurs="0"/>
			<!--<xs:element name="City" type="tAddressIdentity" minOccurs="0"/>-->
			<xs:element name="City" type="tCity" minOccurs="0"/>
			<!--<xs:element name="Village" type="tAddressIdentity" minOccurs="0"/>-->
			<xs:element name="Village" type="tVillage" minOccurs="0"/>
			<xs:element name="StreetAddress" type="tStreetAddress" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tAddressWithUseExtension">
		<xs:complexContent>
			<xs:extension base="tAddress">
				<xs:attribute name="UseDuration" type="tUseDuration"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="tCaption">
		<!--<xs:attributeGroup ref="agTextID"/>-->
		<xs:attribute name="ID" type="tAddressKind" use="required"/>
		<xs:attribute name="Text" type="tStr255"/>
	</xs:complexType>

	<!--<xs:attributeGroup name="agTextID">
		<xs:attribute name="ID" type="tAdressKind" use="required"/>
		<xs:attribute name="Text" type="tStr255"/>
	</xs:attributeGroup>-->
	
	<xs:complexType name="tRegion">							<!--NEW-->
		<xs:attribute name="ID" type="tRegionID" use="required"/>
		<xs:attribute name="Text" type="tStr255"/>
	</xs:complexType>

	<xs:complexType name="tStreetAddress">
		<xs:sequence>
			<!--<xs:element name="Street" type="tAddressIdentity" minOccurs="0"/>-->
			<xs:element name="Street" type="tStreet" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="HouseNum" type="tStr20"/>
		<xs:attribute name="BuildingNum" type="tStr20"/>
		<xs:attribute name="BuildingSymbol" type="tStr20"/>
		<xs:attribute name="FlatNum" type="tStr20"/>
	</xs:complexType>

	<!--<xs:complexType name="tAddressIdentity">
		<xs:attribute name="Caption" type="tStr60" use="required"/>
		<xs:attribute name="Ext" type="tStr10" use="required"/>
	</xs:complexType>-->
	
	<xs:complexType name="tDistrict">				<!--NEW-->
		<xs:attribute name="Caption" type="tStr60" use="required"/>
		<xs:attribute name="Ext" type="tDistrictExt" use="required"/>
	</xs:complexType>
	
	<xs:complexType name="tCity">				<!--NEW-->
		<xs:attribute name="Caption" type="tStr60" use="required"/>
		<xs:attribute name="Ext" type="tCityExt" use="required"/>
	</xs:complexType>
	
	<xs:complexType name="tVillage">				<!--NEW-->
		<xs:attribute name="Caption" type="tStr60" use="required"/>
		<xs:attribute name="Ext" type="tVillageExt" use="required"/>
	</xs:complexType>
	
	<xs:complexType name="tStreet">				<!--NEW-->
		<xs:attribute name="Caption" type="tStr60" use="required"/>
		<xs:attribute name="Ext" type="tStreetExt" use="required"/>
	</xs:complexType>
	
	<xs:complexType name="tPhone">
		<!--<xs:attributeGroup ref="agTextID"/>-->
		<xs:attribute name="ID" type="tPhoneKind" use="required"/>
		<xs:attribute name="Text" type="xs:string"/>
		<xs:attribute name="Number" type="tPhoneNumber"/>
	</xs:complexType>

	<xs:complexType name="tPhoneWithConfirmationExtension">
		<xs:complexContent>
			<xs:extension base="tPhone">
				<xs:attribute name="ConfirmationType" type="tPhoneConfirmation"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="tResponseCapabilities">
		<xs:sequence>
			<xs:element name="BailiffsServiceScores" type="tBailiffsServiceScores" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
		<xs:attribute name="CreditReportDetalization" type="tReportDetalization" use="required"/>
		<xs:attribute name="getExternalCreditReport" type="tGetExternalCreditReport"/>
		<xs:attribute name="getScoringParameters" type="xs:boolean"/>
		<xs:attribute name="SelfRequestInResponse" type="xs:boolean"/>
		<xs:attribute name="PreviousRequestsCountLimit" type="xs:integer"/>
		<xs:attribute name="getRating1" type="xs:boolean"/>
		<xs:attribute name="getRating2" type="xs:boolean"/>
		<xs:attribute name="getRating3" type="xs:boolean"/>
		<xs:attribute name="getRating4" type="xs:boolean"/>
		<xs:attribute name="getTaxServiceLPInfo" type="tTaxServiceLPInfoRequestType"/>
		<xs:attribute name="getTaxServiceIEInfo" type="tTaxServiceIEInfoRequestType"/>
		<xs:attribute name="getVerificationService" type="xs:boolean"/>
		<xs:attribute name="getPaymentHistory" type="tPaymentHistoryRequestSchema"/>
		<xs:attribute name="getMigrationServiceDocumentCheck" type="tgetMigrationServiceDocumentCheck"/>
		<xs:attribute name="getBailiffsServiceDebtInfo" type="xs:boolean"/>
		<xs:attribute name="getBailiffsServiceDebtInfoDetailed" type="xs:boolean"/>
		<xs:attribute name="getTaxServiceDebtInfo" type="xs:boolean"/>
		<xs:attribute name="getFraudInfo" type="xs:boolean"/>
		<xs:attribute name="getRating" type="tBureauRatingRequestSchema"/>
		<xs:attribute name="dispatchBureauAccount" type="xs:boolean"/>
		<xs:attribute name="buildScoring" type="tBuildScoring"/>
		<xs:attribute name="getIdentification" type="tGetIdentification"/>
		<xs:attribute name="getOldReport" type="tGetOldReport"/>
		<xs:attribute name="getReportWithAmp" type="xs:boolean"/>
		<xs:attribute name="getReportFormat" type="tReportFormat"/>
		<xs:attribute name="getAmpFromAllQcb" type="tAmpFromAllQcb"/>				<!--New-->	
	</xs:complexType>
	
	<xs:complexType name="tBailiffsServiceScores">
		<xs:sequence>
			<xs:element name="Score" type="tScore" maxOccurs="unbounded" />
		</xs:sequence>	
	</xs:complexType>
	
	<xs:complexType name="tScore">
		<xs:attribute name="Id" type="tBailiffsServiceScoreId" use="required"/>
	</xs:complexType>
  
	<xs:complexType name="tUrl">
		<xs:attribute name="address" type="tUrlAddress"/>
	</xs:complexType>

	<xs:simpleType name="tUrlAddress">
