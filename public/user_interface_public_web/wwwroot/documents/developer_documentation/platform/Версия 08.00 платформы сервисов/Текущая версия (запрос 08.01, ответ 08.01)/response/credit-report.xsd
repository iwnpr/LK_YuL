			<xs:element name="FL_Doc" type="FL_DocType" minOccurs="0" maxOccurs="unbounded"/>                     		<!--ФЛ 4-->
			<xs:element name="FL_PrevDoc" type="FL_PrevDocType" minOccurs="0" maxOccurs="unbounded"/>             		<!--ФЛ 5-->
			<xs:element name="FL_Tax" type="FL_TaxType" minOccurs="0" maxOccurs="unbounded"/>                           <!--ФЛ 6-->
			<xs:element name="FL_Social" type="FL_SocialType" minOccurs="0" maxOccurs="unbounded"/>                     <!--ФЛ 7-->
		</xs:sequence>
