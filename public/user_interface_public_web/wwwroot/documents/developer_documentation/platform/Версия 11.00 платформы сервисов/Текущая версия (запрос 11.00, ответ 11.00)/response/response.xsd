	<xs:element name="RESPONSE" type="tRESPONSE">
		<xs:annotation>
			<xs:documentation>
				<version>11.00</version>
			</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:complexType name="tRESPONSE">
		<xs:sequence>
			<xs:element name="HEADER" type="tResponseHEADER"/>
			<xs:element name="BODY" type="tResponseBODY"/>
		</xs:sequence>
		<xs:attribute name="version" type="tVersion" use="required"/>
	</xs:complexType>
	<xs:complexType name="tResponseHEADER">
		<xs:sequence>
			<xs:element name="ResponseCreatorDescription" type="tStr255"/>
			<xs:element name="ResponseDateTime" type="tDateTime"/>
			<xs:element name="ResponseID" type="tStr255" minOccurs="0"/>
			<xs:element name="Request" type="tRequestBODY" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="tHistoricalRequestBODY">
		<xs:sequence>
			<xs:element name="RequestAttributes" type="tHistoricalRequestAttributes"/>
			<xs:group ref="gRequestEntities"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="tHistoricalRequestAttributes">
		<xs:complexContent>
			<xs:extension base="tPrevRequestAttributes">
				<xs:attribute name="DateTime" type="tDateTime"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="tPrevRequestAttributes">
		<xs:sequence>
			<xs:element name="ResponseCapabilities" minOccurs="0">
