<CascadingValue Name="Disabled" Value="Disabled">
    @if (Show)
    {
        <div class="fancybox-container fancybox-is-open fancybox-can-swipe" role="dialog" tabindex="-1" id="fancybox-container-1" style="transition-duration: 366ms;">
            <div class="fancybox-bg"></div><div class="fancybox-inner">
                <div class="fancybox-infobar"><span data-fancybox-index="">1</span>&nbsp;/&nbsp;<span data-fancybox-count="">1</span></div><div class="fancybox-toolbar"><button data-fancybox-zoom="" class="fancybox-button fancybox-button--zoom" title="Zoom" disabled=""><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18.7 17.3l-3-3a5.9 5.9 0 0 0-.6-7.6 5.9 5.9 0 0 0-8.4 0 5.9 5.9 0 0 0 0 8.4 5.9 5.9 0 0 0 7.7.7l3 3a1 1 0 0 0 1.3 0c.4-.5.4-1 0-1.5zM8.1 13.8a4 4 0 0 1 0-5.7 4 4 0 0 1 5.7 0 4 4 0 0 1 0 5.7 4 4 0 0 1-5.7 0z"></path></svg></button><button data-fancybox-play="" class="fancybox-button fancybox-button--play" title="Start slideshow" style="display: none;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6.5 5.4v13.2l11-6.6z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M8.33 5.75h2.2v12.5h-2.2V5.75zm5.15 0h2.2v12.5h-2.2V5.75z"></path></svg></button><button data-fancybox-thumbs="" class="fancybox-button fancybox-button--thumbs" title="Thumbnails" style="display: none;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M14.59 14.59h3.76v3.76h-3.76v-3.76zm-4.47 0h3.76v3.76h-3.76v-3.76zm-4.47 0h3.76v3.76H5.65v-3.76zm8.94-4.47h3.76v3.76h-3.76v-3.76zm-4.47 0h3.76v3.76h-3.76v-3.76zm-4.47 0h3.76v3.76H5.65v-3.76zm8.94-4.47h3.76v3.76h-3.76V5.65zm-4.47 0h3.76v3.76h-3.76V5.65zm-4.47 0h3.76v3.76H5.65V5.65z"></path></svg></button><button data-fancybox-close="" class="fancybox-button fancybox-button--close" title="Close"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 10.6L6.6 5.2 5.2 6.6l5.4 5.4-5.4 5.4 1.4 1.4 5.4-5.4 5.4 5.4 1.4-1.4-5.4-5.4 5.4-5.4-1.4-1.4-5.4 5.4z"></path></svg></button></div><div class="fancybox-navigation"><button data-fancybox-prev="" class="fancybox-button fancybox-button--arrow_left" title="Previous" disabled=""><div><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M11.28 15.7l-1.34 1.37L5 12l4.94-5.07 1.34 1.38-2.68 2.72H19v1.94H8.6z"></path></svg></div></button><button data-fancybox-next="" class="fancybox-button fancybox-button--arrow_right" title="Next" disabled=""><div><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M15.4 12.97l-2.68 2.72 1.34 1.38L19 12l-4.94-5.07-1.34 1.38 2.68 2.72H5v1.94z"></path></svg></div></button></div><div class="fancybox-stage">
                    <div class="fancybox-slide fancybox-slide--html fancybox-slide--current fancybox-slide--complete" style="">
                        <div class="popup popup-certificate fancybox-content" id="popup-certificate" style="display: inline-block;">
                            <div class="popup__top">
                                <div class="popup__top-icon"><svg class="ico ico-mono-new-request"><use xlink:href="img/sprite-mono.svg#ico-mono-new-request"></use></svg></div>
                                <div class="popup__top-title">Мастер запроса на сертификат</div>
                            </div>
                            <div class="popup__content">
                                <form class="form">
                                    <div class="popup__step" data-step="2">
                                        <div class="form__inputs">
                                            @if (!isBase64)
                                            {
                                                <div class="form__input">
                                                    <div class="form__input-label">Имя владельца сертификата:</div>
                                                    <input type="text" name="name" value=@Request.Name disabled>
                                                </div>
                                                <div class="form__input">
                                                    <div class="form__input-label">Адрес электронной почты владельца сертификата</div>
                                                    <input type="email" name="email" value=@Request.Email disabled>
                                                </div>
                                                <div class="form__input">
                                                    <div class="form__input-label">Название организации владельца сертификата</div>
                                                    <input type="text" name="certificate_name" value=@Request.Organization disabled>
                                                </div>
                                                <div class="form__input">
                                                    <div class="form__input-label">Криптографический алгоритм открытого ключа</div>
                                                    <input type="text" name="algorythm" value=@Request.Algorithm disabled>
                                                </div>
                                                <div class="form__input">
                                                    <div class="form__input-label">Код страны владельца сертификата</div>
                                                    <input type="text" name="country_code" @bind=Request.Code>
                                                </div>
                                                <div class="form__input">
                                                    <div class="form__input-label">Город владельца сертификата</div>
                                                    <input type="text" name="city" @bind=Request.City>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="form__input">
                                                    <div class="form__input-label">Запрос на сертификат (в кодировке «Base-64»):</div>
                                                    <textarea @bind=Request.Data rows=10 style="margin-left:0;"></textarea>
                                                </div>

                                            }
                                        </div>
                                    </div>
                                    <div class="form__btns">
                                        <button class="form__btn btn btn--green" type="button" @onclick=OnExecute disabled="@Disabled">
                                            @if (Disabled)
                                            {
                                                <img src="/img/loading.gif" width="20" />

                                            }
                                            &nbsp;Отправить&nbsp;
                                        </button>
                                        <a data-fancybox-close id="certCloseLink"></a>
                                    </div>
                                </form>
                            </div>
                            <button type="button" data-fancybox-close="" class="fancybox-button fancybox-close-small" title="Close" @onclick=OnClose>
                                <svg xmlns="http://www.w3.org/2000/svg" version="1" viewBox="0 0 24 24">
                                    <path d="M13 12l5-5-1-1-5 5-5-5-1 1 5 5-5 5 1 1 5-5 5 5 1-1z"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div><div class="fancybox-caption fancybox-caption--separate"><div class="fancybox-caption__body"></div></div>
            </div>
        </div>
    }
</CascadingValue>

@code {
    [CascadingParameter(Name = "Disabled")] public bool Disabled { get; set; } = false;
    [Parameter] public bool Show { get; set; } = false;
    [Parameter] public RequestCertificate Request { get; set; } = new RequestCertificate();
    [Parameter] public EventCallback OnExecute { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string step1 = string.Empty;
    private string step2 = "hidden";
    private bool isBase64 = false;

    protected override void OnParametersSet()
    {
        step1 = string.Empty;
        step2 = "hidden";
        isBase64 = false;
    }

    private void GoTo()
    {
        step1 = step1.Equals("hidden") ? string.Empty : "hidden";
        step2 = step2.Equals("hidden") ? string.Empty : "hidden";
    }

    private void OnRadioChange(bool value)
    {
        isBase64 = value;
        Request.IsBase64 = value;
    }

}
