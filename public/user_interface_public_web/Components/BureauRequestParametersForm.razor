<AuthorizeView Roles="fms-document-check">
    <Authorized>
        <div class="form__checkbox-list">
            <div class="form__input form__checkbox form__checkbox-parameters check">
                <input @bind-value=@Parameters.Fms @bind-value:event="onchange" checked="@Parameters.Fms" type="checkbox" id="FMS">
                <label class="form__checkbox-label" for="10">Запрос в ФМС (проверка паспорта)</label>
            </div>
            <div class="form__checkbox-items" hidden="@(!@Parameters.Fms)">
                <div class="form__input form__checkbox check">
                    <input @bind-value="Parameters.Fns" @bind-value:event="onchange" checked="@Parameters.Fns" type="checkbox" id="FNS">
                    <label class="form__checkbox-label" for="10-1">Запрос в ФМС (проверка паспорта) и ФНС (проверка документ + ФИО и ДР)</label>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        @{
            Parameters.Fms = false;
            Parameters.Fns = false;
        }
    </NotAuthorized>
</AuthorizeView>

