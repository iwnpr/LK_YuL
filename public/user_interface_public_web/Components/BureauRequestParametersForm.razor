<AuthorizeView Roles="credit-report-for-user, credit-report-with-amp">
    <Authorized>
        <div class="caption">Кредитный отчет</div>
        <div class="form__checkbox-list">
            <div class="form__input form__checkbox check form__checkbox-parameters">
                <input type="checkbox" id="CreditReport" @bind-value="Parameters.CreditReport" checked="@Parameters.CreditReport" @bind-value:event="onchange">
                <label class="form__checkbox-label" for="1">Кредитный отчет для пользователя</label>
            </div>
            @if (Parameters.CreditReport)
            {

                <div class="form__checkbox-items">
                    <div class="form__checkbox-item">
                        <div class="form__radio">
                            <input type="radio" name="CreditReportDetalization" id="CreditReportDetalizationTIM" Value="0" @onchange="@(() => Parameters.CreditReportDetalization = Parameters.CreditReport ? 0 : 3)" checked="@(Parameters.CreditReportDetalization.Equals(0))">
                            <div class="form__radio-btn"></div>
                            <label class="form__radio-label" for="parameters-1">Кредитный отчет для пользователя, содержащий титульную, основную и информационную части КИ</label>
                        </div>
                        <div class="form__radio">
                            <input type="radio" name="CreditReportDetalization" id="CreditReportDetalizationTIM" Value="1" @onchange="@(() => Parameters.CreditReportDetalization = Parameters.CreditReport ? 1 : 3)" checked="@(Parameters.CreditReportDetalization.Equals(1))">
                            <div class="form__radio-btn"></div>
                            <label class="form__radio-label" for="parameters-1">Кредитный отчет для пользователя, содержащий только титульную и основную части КИ</label>
                        </div>
                        <div class="form__radio">
                            <input type="radio" name="CreditReportDetalization" id="CreditReportDetalizationTIM" Value="2" @onchange="@(() => Parameters.CreditReportDetalization = Parameters.CreditReport ? 2 : 3)" checked="@(Parameters.CreditReportDetalization.Equals(2))">
                            <div class="form__radio-btn"></div>
                            <label class="form__radio-label" for="parameters-1">Кредитный отчет для пользователя, содержащий только титульную и информационную часть КИ</label>
                        </div>
                    </div>
                    @if (context.User.IsInRole("credit-report-with-amp"))
                    {
                        <div class="form__input form__checkbox check form__checkbox-parameters">
                            <input type="checkbox" id="CreditReport" @bind-value="Parameters.GetReportWithAMP" checked="@Parameters.GetReportWithAMP" @bind-value:event="onchange">
                            <label class="form__checkbox-label" for="1">Сведения о среднемесячных платежах</label>
                        </div>
                    }
                    else
                    {
                        Parameters.GetReportWithAMP = false;
                    }
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        @{
            Parameters.CreditReportDetalization = 3;
            Parameters.GetReportWithAMP = false;
        }
    </NotAuthorized>

</AuthorizeView>

<div class="caption">Дополнительные сервисы</div>

<AuthorizeView Roles="prescoring-np-string-rating">
    <Authorized>
        <div class="form__input form__checkbox check">
            <input type="checkbox" id="getRating1" @bind-value="@Parameters.PreviousRequests" checked="@Parameters.PreviousRequests" @bind-value:event="onchange">
            <label class="form__checkbox-label" for="2">
                Информация о предыдущих запросах &nbsp;
                @if (Parameters.PreviousRequests)
                {
                    <span>(в ответе не более <input type="text" size="5" maxlength="5" @bind="@Parameters.PreviousRequestsCount"> последних)</span>
                }
            </label>
        </div>
    </Authorized>
    <NotAuthorized>
        @{
            Parameters.PreviousRequestsCount = 0;
        }
    </NotAuthorized>
</AuthorizeView>

