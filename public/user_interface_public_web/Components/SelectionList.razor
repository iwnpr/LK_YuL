<div class="page-select-overlay" style="display: @_overlay;" @onclick="@OnSelectChange"></div>
<div class="select @_select">
    <div class="select-styled @_select" @onclick="@OnSelectChange">@(SelectionValue?.Length > 30 ? $"{SelectionValue.Substring(0, 30)}..." : SelectionValue)</div>

    <ul class="select-options" style="display: @_style; max-height: 500px; overflow: auto;">
        @if (ValuesList.Any())
        {
            @foreach (var str in ValuesList)
            {
                <li rel="@str" @onclick=@(() => ValueSelected(@str.Value))>@str.Value</li>
            }
        }
    </ul>
</div>


@code {
    private string _select = string.Empty;
    private string _style = "none";
    private string _overlay = "none";

    /// <summary>
    /// Выбранное значение
    /// </summary>
    [Parameter] public string? SelectionValue { get; set; }

    /// <summary>
    /// Словарь возможных значений (ключ, значение)
    /// </summary>
    [Parameter] public Dictionary<string, string> ValuesList { get; set; } = null!;

    /// <summary>
    /// Метод вызываемы при изменении
    /// </summary>
    [Parameter] public EventCallback<string> OnChange { get; set; }

    /// <summary>
    /// Открыть/закрыть выпадающий список
    /// </summary>
    private void OnSelectChange()
    {
        _select = _select.Equals("active") ? string.Empty : "active";
        _style = _style.Equals("none") ? "block" : "none";
        _overlay = _overlay.Equals("none") ? "block" : "none";
    }

    /// <summary>
    /// Выбор значения
    /// </summary>
    /// <param name="value">Выбранное значение</param>
    /// <returns></returns>
    private async Task ValueSelected(string value)
    {
        SelectionValue = value;
        OnSelectChange();
        await OnChange.InvokeAsync(value);
    }
}
