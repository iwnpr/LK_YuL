@page "/"
@namespace user_interface_web.Pages
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Security.Cryptography.X509Certificates;
@using System.Text.Json
@using user_interface_private_web
@using user_interface_private_web.Entities
@inject ProtectedSessionStorage _session

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";

    var _connection = new ConnectionParameters()
            {
                IpAddress = Request?.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "-",
                UserAgent = Request?.Headers["User-Agent"].ToString() ?? "-",
                SerialNumber = Request?.HttpContext?.Connection?.ClientCertificate?.SerialNumber.ToLower() ?? "1a00000296c6e09d494d302c8b000000000296",
                //SerialNumber = Request?.HttpContext?.Connection?.ClientCertificate?.SerialNumber.ToLower() ?? string.Empty,
                Thumbprint = Request?.HttpContext?.Connection?.ClientCertificate?.Thumbprint.ToLower() ?? "d84dc8d9561a39412baabf0224a556fb1e17432e"
                //Thumbprint = Request?.HttpContext?.Connection?.ClientCertificate?.Thumbprint.ToLower() ?? string.Empty
            };
}

<component type="typeof(App)" render-mode="Server" param-User="@_connection" />
