@layout ResponseLayout
@page "/private/current-request-of-qbch/{Id}"
@attribute [Authorize(Roles = "qbch")]

<PageTitle>Запросы ССП</PageTitle>

<h1 class="status__title title title--h1">Запросы ССП</h1>
@if (_request is not null)
        {
<SubjectQBCH Request="@(XDocument.Parse(_request.Request ?? "<ЗапросСведенийОПлатежах />"))"></SubjectQBCH>
<TableRequestOfQBCH Response="@_request.Response" />
        }

<AuthorizeView Roles="organizations, users, certificates">
    <Authorized>
        @{
                _isAdmin = true;
        }
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public string? Id { get; set; }

    bool _isAdmin = false;

    /// <summary>
    /// Пользователь, осуществивший вход
    /// </summary>
    private DBUser? _user = new();

    private DBRequestOfQBCH? _request;

    protected override async Task OnInitializedAsync()
    {
    _user = (await _session.GetAsync<DBUser>("UserDB")).Value;

    if (_user is null)
    {
        _navMngr.NavigateTo("error");
        return;
    }

    int.TryParse(Id, out int _id);

    _request = await _requestMngr.GetAsync<DBRequestOfQBCH>(_id, _user.Id, _isAdmin);

    if (_request is null)
    {
        _navMngr.NavigateTo("404");
    }

    await _jsr.InvokeVoidAsync("AddStyle");
    }


}
