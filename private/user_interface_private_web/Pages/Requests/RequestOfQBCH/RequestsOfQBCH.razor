@page "/private/requests-of-qbch"
@using System.Text
@attribute [Authorize(Roles = "qbch")]

<PageTitle>Запросы ССП</PageTitle>

<AuthorizeView Roles="organizations, users, certificates">
    <Authorized>
        @{
            _isAdmin = true;
        }
    </Authorized>
</AuthorizeView>

<CascadingValue Name="Disabled" Value="_disabled">
    <RequestOfQBCHWindow Show=_show
                         Subject="_requestXml"
                         Method="SendRequestAsync"
                         OnClose="(() => _show = false)" />
</CascadingValue>

<CommentWindow InfoComment="@_comment" />

<section class="status">
    <div class="l-content">
        <h1 class="status__title title title--h1">Запросы ССП</h1>
        <div class="status__items">
            <a class="status__item" @onclick="@(() => RequestFormShow(true))">
                <div class="status__item-icon">
                    <svg class="ico ico-mono-add-doc">
                        <use xlink:href="img/sprite-mono.svg#ico-mono-add-fl"></use>
                    </svg>
                </div>
                <div class="status__item-title">ФЛ</div>
            </a>
        </div>
        <form> <input type="text" data-format="00.00.0000" required></form>
        <TableRequests Requests="_requests" Url="private/current-request-of-qbch" Type="RequestType.qbch" UserId="_user.Id" />
    </div>
</section>

@code {
    [CascadingParameter(Name = "Disabled")] public bool _disabled { get; set; } = false;

    private bool _isAdmin = false;

    /// <summary>
    /// Пользователь, осуществивший вход
    /// </summary>
    private DBUser _user = new();

    /// <summary>
    /// Комментарий для информационного модального окна
    /// </summary>
    private Comment _comment = new Comment(false, string.Empty, string.Empty, string.Empty);

    /// <summary>
    /// Запрос на сервис бюро
    /// </summary>
    private RequestAMP _requestXml = new();

    /// <summary>
    /// Результат методов сервисов
    /// </summary>
    private Answer _error = new(500, "Ошибка сервера");

    /// <summary>
    /// Признак отображение модального окна
    /// </summary>
    private bool _show = false;

    /// <summary>
    /// Запросы из БД
    /// </summary>
    private List<RequestRecord> _requests = new();

    /// <summary>
    /// Запрос к сервисам бюро
    /// </summary>
    private DBRequestOfQBCH _request = new();

    private byte[] _responseBytes = new byte[100];

    /// <summary>
    /// Инициализация страницы
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        var _result = await _session.GetAsync<DBUser>("UserDB");

        if (!_result.Success)
        {
            _navMngr.NavigateTo("error");
            return;
        }

        ProtectedBrowserStorageResult<string> _connection = await _session.GetAsync<string>("Connection");

        _user = _result.Value!;

        _requests = await _requestMngr.GetListAsync<DBRequestOfQBCH>(_user.Id, 0, _isAdmin);

    }

    /// <summary>
    /// Рендеринг страницы
    /// </summary>
    /// <param name="firstRender"></param>
    /// <returns></returns>
    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _jsr.InvokeVoidAsync("mask");
        }
    }

    /// <summary>
    /// Отправка запроса на сервис
    /// </summary>
    /// <returns></returns>
    private async Task SendRequestAsync()
    {
        _disabled = true;

        if (_requestXml.RequestType == "2" && _requestXml.InformationCode == "8")
        {
            _comment = new Comment(true, "error", "Запрос ССП", "Для запроса ко всем КБКИ нельзя выбрать сведения с кодом 8.");
            _disabled = false;
            return;
        }

        _error = _validator.Check(_requestXml);

        if (!_error.Code.Equals(200))
        {
            _comment = new Comment(true, "error", "Запрос ССП", _error.Message);
            _disabled = false;
            return;
        }

        _requestXml.RequestId = Guid.NewGuid().ToString();
        _requestXml.Request.Subject.BirthDate = DateTime.Parse(_requestXml.Request.Subject.BirthDate).ToString("yyyy-MM-dd");
        _requestXml.Request.Subject.IdentityDocument.DocDate = DateTime.Parse(_requestXml.Request.Subject.IdentityDocument.DocDate).ToString("yyyy-MM-dd");
        _requestXml.Request.Consent.ConsentDate = DateTime.Parse(_requestXml.Request.Consent.ConsentDate).ToString("yyyy-MM-dd");
        //_requestXml.Request.Consent.Issued.IssuedLegalEntity.FullName = _requestXml.Request.Consent.Issued.IssuedLegalEntity.FullName.Replace("«", "\"").Replace("»", "\"");
        //_requestXml.Request.Consent.Issued.IssuedLegalEntity.ShortName = _requestXml.Request.Consent.Issued.IssuedLegalEntity.ShortName.Replace("«", "\"").Replace("»", "\"");
        //_requestXml.Request.Source.SourceLegalEntity.ShortName = _requestXml.Request.Source.SourceLegalEntity.ShortName.Replace("«", "\"").Replace("»", "\"");
        //_requestXml.Request.Source.SourceLegalEntity.FullName = _requestXml.Request.Source.SourceLegalEntity.FullName.Replace("«", "\"").Replace("»", "\"");
        _requestXml.Request.Amount.Text = _requestXml.Request.Amount.Text.Replace(",", ".");
        _requestXml!.Request.Subject.Initials.LastName = _requestXml.Request.Subject.Initials.LastName.Trim();
        _requestXml!.Request.Subject.Initials.FirstName = _requestXml.Request.Subject.Initials.FirstName.Trim();
        _requestXml!.Request.Subject.Initials.MiddleName = _requestXml.Request.Subject.Initials.MiddleName.Trim();
        _requestXml!.Request.Subject.IdentityDocument.Seria = _requestXml.Request.Subject.IdentityDocument.Seria.Trim();
        _requestXml!.Request.Subject.IdentityDocument.Number = _requestXml.Request.Subject.IdentityDocument.Number.Trim();


        _request.Request = _requestXml.Serialize();

        _requestXml.Request.Subject.BirthDate = DateTime.Parse(_requestXml.Request.Subject.BirthDate).ToString("dd.MM.yyyy");
        _requestXml.Request.Subject.IdentityDocument.DocDate = DateTime.Parse(_requestXml.Request.Subject.IdentityDocument.DocDate).ToString("dd.MM.yyyy");
        _requestXml.Request.Consent.ConsentDate = DateTime.Parse(_requestXml.Request.Consent.ConsentDate).ToString("dd.MM.yyyy");
        _requestXml.Request.Amount.Text = _requestXml.Request.Amount.Text.Replace(".", ",");



        // Подписание запроса
        string? _base64 = await _jsr.InvokeAsync<string>("CreateSign", _requestXml.Thumbprint, _stringMngr.Base64Encode(_request.Request));



        byte[] _bytes = new byte[0];

        FetchAnswer _answer = new();

        try
        {
            _bytes = Convert.FromBase64String(_base64);
            _request.SignedRequest = _base64;
        }
        catch
        {
            _comment = new Comment(true, "error", "Ошибка при обработке запроса", _base64);
            _disabled = false;
            return;
        }

        _answer = await FetchAsync($"{_configuration.GetSection("Links:QBCH").Value}/dlrequest", _bytes, "POST");

        if (_answer.Message.Length == 0)
        {
            _comment = new Comment(true, "error", "Ошибка при обработке запроса", "При отправке запроса произошла ошибка!");
            _disabled = false;
            return;
        }

        try
        {
            //Снятие подписи
            var signedCms = new SignedCms();
            signedCms.Decode(_answer.Message);

            string _dlrequest = Encoding.UTF8.GetString(signedCms.ContentInfo.Content).Trim(new char[] { '\uFEFF' });

            if (_dlrequest.Contains("<ИдентификаторОтвета"))
            {
                _request.Ticket = XDocument.Parse(_dlrequest)?.Root?.Element("ИдентификаторОтвета")?.Value;

                if (_request.Ticket is null)
                {
                    _comment = new Comment(true, "error", "Ошибка при обработке запроса", "При отправке запроса произошла ошибка!");
                    _disabled = false;
                    return;
                }

                await Task.Delay(20000);

                _answer = await FetchAsync($"{_configuration.GetSection("Links:QBCH").Value}/dlanswer?id={_request.Ticket}", _bytes, "GET");

                if (_answer.Message.Length == 0)
                {
                    _comment = new Comment(true, "error", "Ошибка при обработке запроса", "При отправке запроса произошла ошибка!");
                    _disabled = false;
                    return;
                }

                signedCms.Decode(_answer.Message);
            }

            //Убираем преамбулу у сообщения (UTF8-BOM)
            _request.Response = Encoding.UTF8.GetString(signedCms.ContentInfo.Content).Trim(new char[] { '\uFEFF' });
            _request.SignedResponse = _stringMngr.Base64Encode(Encoding.UTF8.GetString(_answer.Message).Trim(new char[] { '\uFEFF' }));
        }
        catch
        {
            _comment = new Comment(true, "error", "Ошибка при обработке запроса", "При отправке запроса произошла ошибка!");
            _disabled = false;
            return;
        }

        _request.Updated = DateTime.Now;

        XDocument _response = new();
        try
        {
            _response = XDocument.Parse(_request.Response);
        }
        catch
        {
            _comment = new Comment(true, "error", "Ошибка при обработке запроса", "При отправке запроса произошла ошибка!");
            _disabled = false;
            return;

        }

        _request.Status = _response.Descendants("Сведения").Any() ? 1 : 3;

        _request.Inserted = DateTime.Now;

        _error = await _requestMngr.InsertAsync(_request);

        if (_error.Code.Equals(200))
        {
            _comment = new Comment(true, "ok", "Запрос ССП", _error.Message);
            _show = false;
            _disabled = false;
            _requests = await _requestMngr.GetListAsync<DBRequestOfQBCH>(_user.Id, 0, _isAdmin) ?? new List<RequestRecord>();
            return;
        }


        _disabled = false;

    }

    /// <summary>
    /// Показать окно для формирования запроса
    /// </summary>
    private void RequestFormShow(bool isNaturalPerson)
    {
        _requestXml = _requestMngr.CreateRequestQBCH(_user.Organization);

        _request = new()
            {
                Inserted = DateTime.Now,
                UserId = _user.Id,
                OrganizationId = _user.OrganizationId,
                Request = _requestXml.Serialize()
            };

        _show = true;

    }

    private async Task<FetchAnswer> FetchAsync(string _url, byte[] _bytes, string _type)
    {
        FetchAnswer _answer = new();

        try
        {
            var dataReference =
                _type.Equals("POST")
                    ? await _jsr.InvokeAsync<IJSStreamReference>("PostBytesAsync", _url, _bytes)
                    : await _jsr.InvokeAsync<IJSStreamReference>("GetBytesAsync", _url);

            using var dataReferenceStream =
                await dataReference.OpenReadStreamAsync(maxAllowedSize: 10_000_000);

            using (MemoryStream ms = new MemoryStream())
            {
                await dataReferenceStream.CopyToAsync(ms);
                _answer.Message = ms.ToArray();
                _answer.Code = 200;
            }
        }
        catch
        {
            _answer = new() { Code = 200, Message = new byte[0] };
        }

        return _answer;
    }

}

