            <div class="fancybox-slide fancybox-slide--html fancybox-slide--current fancybox-slide--complete" style="">
                <div class="status-popup status-popup-comment fancybox-content" id="status-popup-comment" style="display: inline-block;">
                    <div class="l-content">
                        <h1 class="status-popup__title title title--h1" tabindex="-1">Загрузка файла</h1>
                        <div class="status-popup-comment__form form">
                            <div class="form__inputs">
                                <div class="form__input-upload">
                                    <div class="form__input">
                                        @* <div class="form__input-label">Загрузить файл</div> *@
                                        <div class="form__input-file">
                                            <InputFile OnChange="OnInputFileChange" id="uploadFile" />
