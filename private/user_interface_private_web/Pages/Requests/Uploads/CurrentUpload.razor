        string fileName = _document.Attribute("file-name")?.Value ?? "untitled.bin";

        Stream? streamToReadFrom = null;

        try
        {
            var _answer = await _http.PostAsync(url, new StringContent(_document.ToString()));

            if (!_answer.IsSuccessStatusCode)
            {
                _window = new(true, "error", "Ошибка", "При скачивании файла произошла ошибка. Попробуйте позднее");
                return;
            }

            streamToReadFrom = await (_answer).Content.ReadAsStreamAsync();
        }
        catch
        {
            _window = new(true, "error", "Ошибка", "При скачивании файла произошла ошибка. Попробуйте позднее");

            return;
        }

        using var streamRef = new DotNetStreamReference(stream: streamToReadFrom);

        await _jsr.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);


    }

