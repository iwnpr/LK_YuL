@page "/private/requests-from-government"
@attribute [Authorize]

<PageTitle>Запросы для Госорганов</PageTitle>
<CascadingValue Name="Disabled" Value="_disabled">
    <RequestsFromGovernmentWindow Show=_show
                                  Subject="_requestXml"
                                  RequestForGovernment="_requestDB"
                                  Method="SendRequestAsync"
                                  OnClose="(() => _show = false)" />


</CascadingValue>

<CommentWindow InfoComment="@_comment" />

<section class="status">
    <div class="l-content">
        <h1 class="status__title title title--h1">Запросы для Госорганов</h1>
        <div class="status__items">
            <a class="status__item" @onclick="(() => SubjectFormShow(true))">
                <div class="status__item-icon">
                    <svg class="ico ico-mono-add-doc">
                        <use xlink:href="img/sprite-mono.svg#ico-mono-add-fl"></use>
                    </svg>
                </div>
                <div class="status__item-title">Поиск ФЛ</div>
            </a>
            <a class="status__item" @onclick="(() => SubjectFormShow(false))">
                <div class="status__item-icon">
                    <svg class="ico ico-mono-print">
                        <use xlink:href="img/sprite-mono.svg#ico-mono-add-ur"></use>
                    </svg>
                </div>
                <div class="status__item-title">Поиск ЮЛ</div>
            </a>
        </div>
        <TableRequests Requests="_requests" Url="private/current-request-from-government" Type="RequestType.government" UserId="_user.Id" />
    </div>
</section>


@code {
    [CascadingParameter(Name = "Disabled")] public bool _disabled { get; set; } = false;

/// <summary>
/// Пользователь, осуществивший вход
/// </summary>
private DBUser? _user = new();

/// <summary>
/// Комментарий для информационного модального окна
/// </summary>
private Comment _comment = new Comment(false, string.Empty, string.Empty, string.Empty);

/// <summary>
/// Запрос на сервис бюро
/// </summary>
private Request _requestXml = new();

/// <summary>
/// Отображение модального окна
/// </summary>
private bool _show = false;

/// <summary>
/// Запросы из БД
/// </summary>
private List<RequestRecord> _requests = new();

private DBRequestForGovernmentByUser _requestDB = new();

protected override async Task OnInitializedAsync()
{
    _user = (await _session.GetAsync<DBUser>("UserDB")).Value;

    if (_user is null)
    {
    _navMngr.NavigateTo("error");
    return;
    }

    _requests = await _requestMngr.GetListAsync<DBRequestForGovernmentByUser>(_user.Id, 0, false);
}

/// <summary>
/// Отправка запроса на сервис
/// </summary>
/// <returns></returns>
private async Task SendRequestAsync()
{
    _disabled = true;

    _requestDB.Inserted = DateTime.Now;

    _requestXml.Body.RequestAttributes.ResponseCapabilities.CreditReportDetalization =
    _requestDB.GovernmentId switch
    {
    DBGovernment.court or DBGovernment.central_bank or DBGovernment.preliminary_investigation_authorities => -10001,
    DBGovernment.financial_manager => -10006,
    DBGovernment.federal_bailiff_service => -10004,
    DBGovernment.notary => -10003,
    _ => 3
    };

    Answer _answer = _requestXml.Body.NaturalPersonSubject is not null
    ? _validator.Check(_requestXml.Body.NaturalPersonSubject.IdentificationDocuments[0])
    : _validator.Check(_requestXml.Body.LegalPersonSubject!);

    if (!_answer.Code.Equals(200))
    {
    _comment = new(true, "error", "Запросы Госорганы", _answer.Message);
    _disabled = false;
    return;
    }

    _requestDB.Request = _requestXml.Serialize();

    // Отправляем запрос и ожидаем ответ
    _answer = await _requestMngr.SendRequestAsync<DBRequestForGovernmentByUser>(_requestDB);


    //Выводим сообщение пользователю
    if (_answer.Code.Equals(200))
    {
    _comment = new Comment(true, "ok", "Запросы Госорганы", _answer.Message);
    _show = false;
    _disabled = false;
    _requests = await _requestMngr.GetListAsync<DBRequestForGovernmentByUser>(_user.Id, 0, false) ?? new List<RequestRecord>();
    return;
    }

    _comment = new Comment(true, "error", "Запросы Госорганы", _answer.Message);

    _disabled = false;

}

/// <summary>
/// Показать окно для формирования запроса по субъекту
/// </summary>
private void SubjectFormShow(bool _isNaturalPerson)
{
    _requestXml = _requestMngr.CreateRequest(_isNaturalPerson, _user.Organization);

    _requestDB = new()
    {
        Inserted = DateTime.UtcNow,
        UserId = _user.Id,
        OrganizationId = _user.OrganizationId,
        Request = _requestXml.Serialize()
    };

    _show = true;

}



}

