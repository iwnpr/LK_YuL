<AuthorizeView Roles="self-employment-service">
    <Authorized>
        <div class="form__checkbox-list">
            <div class="form__input form__checkbox check">
                <input type="checkbox"
                       id="GetSelfEmployedCheck"
                       @bind="Parameters.GetSelfEmployedCheck">
                <label class="form__checkbox-label" for="GetSelfEmployedCheck">
                    Запрос статуса самозанятого
                </label>
            </div>

            @if (Parameters.GetSelfEmployedCheck)
            {
                <div class="form__checkbox-items">
                    <div class="form__input">
                        <div class="form__input-label">Дата проверки</div>
                        <input
                            type="text" data-format="00.00.0000"
                            title="Дата в формате дд.мм.гггг"
                            @bind="@Model.ResponseCapabilities.GetSelfEmployedCheck.CheckDate" required/>
                    </div>
                </div>
            }
        </div>
    </Authorized>

    <NotAuthorized>
        @{
            Parameters.GetSelfEmployedCheck = false;
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    // TODO: вынести в отдельный класс
    [Parameter]
    public ParametersBureau Parameters { get; set; } = new();
    
    [Parameter]
    public BureauRequestModel Model { get; set; } = new();

    private void OnCreditReportChanged(ChangeEventArgs args)
    {
        Parameters.CreditReport = GetCheckedValue(args);

        if (Parameters.CreditReport)
        {
            if (Parameters.CreditReportDetalization is < 0 or > 2)
            {
                Parameters.CreditReportDetalization = 0;
            }

            return;
        }

        Parameters.CreditReportDetalization = 3;
        Parameters.GetReportWithAMP = false;
    }

    private void OnFmsChanged(ChangeEventArgs args)
    {
        Parameters.Fms = GetCheckedValue(args);

        if (!Parameters.Fms)
        {
            Parameters.Fns = false;
        }
    }

    private static bool GetCheckedValue(ChangeEventArgs args)
    {
        return args.Value is true;
    }
}
