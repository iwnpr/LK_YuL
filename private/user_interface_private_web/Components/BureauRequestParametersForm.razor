@using user_interface_private_web.Pages.Requests.RequestOfBureau
<style>
    .strike-through {
        text-decoration: line-through;
    }
</style>

<AuthorizeView Roles="credit-report-for-user, credit-report-with-amp">
    <Authorized>
        <div class="caption">Кредитный отчет</div>
        <div class="form__checkbox-list">
            <div class="form__input form__checkbox check form__checkbox-parameters">
                <input type="checkbox"
                       id="CreditReport"
                       checked="@Parameters.CreditReport"
                       disabled="@Parameters.GetReportWithBailiffsDebtInfo"
                       @onchange="OnCreditReportChanged">
                <label class="form__checkbox-label @(Parameters.GetReportWithBailiffsDebtInfo ? "strike-through" : "")"
                       for="CreditReport">
                    Кредитный отчет для пользователя
                </label>
            </div>

            @if (Parameters.CreditReport)
            {
                <div class="form__checkbox-items">
                    <div class="form__checkbox-item">
                        <div class="form__radio">
                            <input type="radio"
                                   name="CreditReportDetalization"
                                   id="CreditReportDetalization0"
                                   value="0"
                                   @onchange="@(() => Parameters.CreditReportDetalization = 0)"
                                   checked="@(Parameters.CreditReportDetalization == 0)">
                            <div class="form__radio-btn"></div>
                            <label class="form__radio-label" for="CreditReportDetalization0">
                                Кредитный отчет для пользователя, содержащий титульную, основную и информационную части КИ
                            </label>
                        </div>

                        <div class="form__radio">
                            <input type="radio"
                                   name="CreditReportDetalization"
                                   id="CreditReportDetalization1"
                                   value="1"
                                   @onchange="@(() => Parameters.CreditReportDetalization = 1)"
                                   checked="@(Parameters.CreditReportDetalization == 1)">
                            <div class="form__radio-btn"></div>
                            <label class="form__radio-label" for="CreditReportDetalization1">
                                Кредитный отчет для пользователя, содержащий только титульную и основную части КИ
                            </label>
                        </div>

                        <div class="form__radio">
                            <input type="radio"
                                   name="CreditReportDetalization"
                                   id="CreditReportDetalization2"
                                   value="2"
                                   @onchange="@(() => Parameters.CreditReportDetalization = 2)"
                                   checked="@(Parameters.CreditReportDetalization == 2)">
                            <div class="form__radio-btn"></div>
                            <label class="form__radio-label" for="CreditReportDetalization2">
                                Кредитный отчет для пользователя, содержащий только титульную и информационную часть КИ
                            </label>
                        </div>
                    </div>

                    @if (context.User.IsInRole("credit-report-with-amp"))
                    {
                        <div class="form__input form__checkbox check form__checkbox-parameters">
                            <input type="checkbox"
                                   id="GetReportWithAMP"
                                   @bind="Parameters.GetReportWithAMP">
                            <label class="form__checkbox-label" for="GetReportWithAMP">
                                Сведения о среднемесячных платежах
                            </label>
                        </div>
                    }
                    else
                    {
                        Parameters.GetReportWithAMP = false;
                    }
                </div>
            }
        </div>
    </Authorized>

    <NotAuthorized>
        @{
            Parameters.CreditReport = false;
            Parameters.CreditReportDetalization = 3;
            Parameters.GetReportWithAMP = false;
        }
    </NotAuthorized>
</AuthorizeView>

<div class="caption">Дополнительные сервисы</div>

<AuthorizeView Roles="prescoring-np-string-rating">
    <Authorized>
        <div class="form__input form__checkbox check">
            <input type="checkbox"
                   id="PreviousRequests"
                   @bind="Parameters.PreviousRequests">
            <label class="form__checkbox-label" for="PreviousRequests">
                Информация о предыдущих запросах
            </label>

            @if (Parameters.PreviousRequests)
            {
                <span>
                    (в ответе не более
                    <input type="text"
                           id="PreviousRequestsCount"
                           size="5"
                           maxlength="5"
                           aria-label="Количество предыдущих запросов"
                           @bind="Parameters.PreviousRequestsCount">
                    последних)
                </span>
            }
        </div>
    </Authorized>

    <NotAuthorized>
        @{
            Parameters.PreviousRequests = false;
            Parameters.PreviousRequestsCount = 0;
        }
    </NotAuthorized>
</AuthorizeView>

<AuthorizeView Roles="fms-document-check">
    <Authorized>
        <div class="form__checkbox-list">
            <div class="form__input form__checkbox form__checkbox-parameters check">
                <input type="checkbox"
                       id="Fms"
                       checked="@Parameters.Fms"
                       @onchange="OnFmsChanged">
                <label class="form__checkbox-label" for="Fms">
                    Запрос в ФМС (проверка паспорта)
                </label>
            </div>

            @if (Parameters.Fms)
            {
                <div class="form__checkbox-items">
                    <div class="form__input form__checkbox check">
                        <input type="checkbox"
                               id="Fns"
                               @bind="Parameters.Fns">
                        <label class="form__checkbox-label" for="Fns">
                            Запрос в ФМС (проверка паспорта) и ФНС (проверка документ + ФИО и ДР)
                        </label>
                    </div>
                </div>
            }
        </div>
    </Authorized>

    <NotAuthorized>
        @{
            Parameters.Fms = false;
            Parameters.Fns = false;
        }
    </NotAuthorized>
</AuthorizeView>

