@code {
    [Parameter] public string Response { get; set; } = "<Результат />";

    private Dictionary<string, bool> _show =
    new Dictionary<string, bool>()
    {
        {"1047796788819", false },
        {"1247700058319", false },
        {"1057747734934", false },
        {"1057746710713", false }
    };

    private XDocument _response = new(new XElement("Результат"));

    protected override void OnInitialized()
    {
    _response = XDocument.Parse(Response ?? "<Результат />");
    }

    private static string GetReferenceValue(Dictionary<string, string> reference, string? value)
    {
        return value is not null && reference.TryGetValue(value, out var description) ? description : value ?? "-";
    }

}
