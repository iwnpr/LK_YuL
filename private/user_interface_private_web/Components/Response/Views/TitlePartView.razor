@if ((_titlePart?.Descendants("AddressOld").Any() ?? false) || (_titlePart?.Descendants("AddressInfo").Any() ?? false))
{
    <div class="document__table-content document__table--general">
        <table class="document__table">
            <thead>
                <tr>
                    <td>Адрес юридического лица</td>
                    <td>Дата актуальности</td>
                    @if (hasPrivate)
                    {
                        <td>Источник КИ</td>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var ad in _titlePart?.Descendants("AddressOld") ?? Enumerable.Empty<XElement>())
                {
                    <tr>
                        <td>@ad?.Element("AddressString")?.Value д. @ad?.Element("StreetAddress")?.Attribute("HouseNum")?.Value кв. @ad?.Element("StreetAddress")?.Attribute("FlatNum")?.Value</td>
                        <td>@ad?.Attribute("ActualityDate")?.Value</td>
                        @if (hasPrivate)
                        {
                            <td>GetOwnerById(ad.Attribute("OwnerID")!.Value).Caption</td>
                        }
                    </tr>
                }
                @foreach (var _address in _titlePart?.Descendants("AddressInfo") ?? Enumerable.Empty<XElement>())
                {
                    <tr>
                        <td>
                            @*индекс @(_address.Element("Address")?.Attribute("PostCode")?.Value ?? "-"), *@
                            @*страна*@ @(_address.Element("Address")?.Attribute("CountryName")?.Value ?? _address.Element("Address")?.Attribute("AnotherCountryName")?.Value ?? "-"),
                            @*фиас @(_address.Element("Address")?.Attribute("FiasNum")?.Value ?? "-"), *@
                            @*нас. пункт*@ @(_address.Element("Address")?.Attribute("LocalityName")?.Value ?? _address.Element("Address")?.Attribute("OtherLocalityName")?.Value ?? "-"),
                            ул. @(_address.Element("Address")?.Attribute("Street")?.Value ?? "-"),
                            д. @(_address.Element("Address")?.Attribute("HouseNum")?.Value ?? "-"),
                            владение @(_address.Element("Address")?.Attribute("Ownership")?.Value ?? "-"),
                            к. @(_address.Element("Address")?.Attribute("Housing")?.Value ?? "-"),
                            стр. @(_address.Element("Address")?.Attribute("Building")?.Value ?? "-"),
                            кв. @(_address.Element("Address")?.Attribute("FlatNum")?.Value ?? "-")
                        </td>
                        <td>@_address?.Attribute("ActualityDate")?.Value</td>
                        @if (hasPrivate)
                        {
                            <td>GetOwnerById(_address!.Attribute("OwnerID")!.Value).Caption</td>
                        }

                    </tr>
                }
            </tbody>
        </table>
    </div>
}

        }

