@code {
    [Parameter] public XDocument Response { get; set; } = new(new XElement("RESPONSE"));
    
    private XElement _titlePart = new("TitlePart");

    private bool hasPrivate = false;

    protected override void OnInitialized()
    {
        _titlePart = Response.Descendants("TitlePart").FirstOrDefault() ?? new("TitlePart");
    }
}