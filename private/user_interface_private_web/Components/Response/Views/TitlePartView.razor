<h2 class="document__title document__title--h2 document__title--black">Титульная часть кредитной истории</h2>


@if (_titlePart?.Element("NaturalPersonSubject") is not null)
        {
<div class="document__caption"><span class="document__table-icon"><img src="img/user.svg" alt="">  Данные субъекта </span></div>
<div class="document__table-content document__table--general">
    <table class="document__table">
        <thead>
            <tr>
                <td>Фамилия Имя Отчество</td>
                <td>Дата рождения</td>
                <td>Дата актуальности</td>
                @if (hasPrivate)
                {
                    <td>Источник КИ</td>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var tp in _titlePart?.Descendants("Title") ?? Enumerable.Empty<XElement>())
            {
                <tr>
                    <td>@tp?.Attribute("LastName")?.Value @tp?.Attribute("FirstName")?.Value @tp?.Attribute("MiddleName")?.Value</td>
                    <td>@DateOnly.Parse(tp?.Attribute("BirthDate")?.Value ?? DateTime.Now.ToString("dd.MM.yyyy"))</td>
                    <td>@tp?.Attribute("ActualityDate")?.Value</td>
                    @if (hasPrivate)
                    {
                        <td>GetOwnerById(tp?.Attribute("OwnerID")?.Value ?? "0").Caption</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@*Место рождения*@
@if (_titlePart?.Descendants("PersonalInformation").Where(x => x?.Attribute("BirthPlace")?.Value != null)?.Count() > 0)
{
    <div class="document__table-content document__table--general">
        <table class="document__table">
            <thead>
                <tr>
                    <td>Место рождения</td>
                    <td>Дата актуальности</td>
                    @if (hasPrivate)
                    {
                        <td>Источник КИ</td>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var tp in _titlePart?.Descendants("PersonalInformation")
               .Where(x => x?.Attribute("BirthPlace")?.Value != null)?
               .Select(p => new
               {
                   BirthPlace = p.Attribute("BirthPlace")?.Value ?? "-",
                   CreationDate = p.Attribute("ActualityDate")?.Value ?? "-",
                   OwnerID = p.Attribute("OwnerID")?.Value ?? "0"
               }).Distinct().ToList() ?? new())
                {
                    <tr>
                        <td>@tp.BirthPlace</td>
                        <td>@tp.CreationDate</td>
                        @if (hasPrivate)
                        {
                            <td>GetOwnerById(tp.OwnerID).Caption</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@*Документы*@
<div class="document__caption"><span class="document__table-icon"><img src="img/doc-grey.svg" alt="">  Документы субъекта </span></div>
<div class="document__table-content document__table--general">
    <table class="document__table">
        <thead>
            <tr>
                <td>Документ, удостоверяющий личность</td>
                <td>Серия и номер документа</td>
                <td>Дата выдачи документа</td>
                <td>Место выдачи и код подразделения</td>
                <td>Дата актуальности</td>
                @if (hasPrivate)
                {
                    <td>Источник КИ</td>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var tp in _titlePart?.Descendants("IdentificationDocument") ?? Enumerable.Empty<XElement>())
            {
                <tr>
                    <td>@_dictionary.DocumentTypes[tp.Attribute("DocTypeID")!.Value!]</td>
                    <td>@(tp?.Attribute("DocSer")?.Value ?? "") @(tp?.Attribute("DocNum")?.Value ?? "-")</td>
                    <td>@(tp?.Attribute("DocDate")?.Value ?? "-")</td>
                    <td>@(tp?.Attribute("DocDelivInstName")?.Value ?? "-"), @(tp?.Attribute("DocDelivInstCode")?.Value ?? "-")</td>
                    <td>@(tp?.Attribute("ActualityDate")?.Value ?? "-")</td>
                    @if (hasPrivate)
                    {
                        <td>GetOwnerById(tp?.Attribute("OwnerID")?.Value ?? "0").Caption</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

