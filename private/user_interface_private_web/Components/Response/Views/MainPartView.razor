<h2 class="document__title document__title--h2 document__title--black">Основная часть кредитной истории</h2>

@if ((_mainPart?.Descendants("AddressOld")?.Any() ?? false) || (_mainPart?.Descendants("AddressInfo")?.Any() ?? false))
{
    <div class="document__caption"><span class="document__table-icon"><img src="img/location.svg" alt="">  Адреса субъекта </span></div>

    @if ((_mainPart?.Descendants("AddressOld")?.Where(x => x.Element("Caption")?.Attribute("ID")?.Value == "1").Any() ?? false) || (_mainPart?.Descendants("AddressInfo")?.Where(a => (a?.Attribute("ActualAddressDif")?.Value ?? a?.Attribute("IsActualAddress")?.Value ?? "0").Equals("0"))?.Any() ?? false))
    {
        <div class="document__table-content document__table--general">
            <table class="document__table">
                <thead>
                    <tr>
                        <td>Адрес регистрации по месту жительства</td>
                        <td>Дата актуальности</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ad in _mainPart?.Descendants("AddressOld")?.Where(x => x.Element("Caption")?.Attribute("ID")?.Value == "1") ?? Enumerable.Empty<XElement>())
                    {
                        <tr>
                            <td>@ad?.Element("AddressString")?.Value д. @ad?.Element("StreetAddress")?.Attribute("HouseNum")?.Value кв. @ad?.Element("StreetAddress")?.Attribute("FlatNum")?.Value</td>
                            <td>@ad?.Attribute("ActualityDate")?.Value</td>
                        </tr>
                    }
                    @foreach (var _address in _mainPart?.Descendants("AddressInfo")?.Where(a => (a?.Attribute("ActualAddressDif")?.Value ?? a?.Attribute("IsActualAddress")?.Value ?? "0").Equals("0")) ?? Enumerable.Empty<XElement>())
                    {
                        <tr>
                            <td>
                                @*индекс @(_address.Element("Address")?.Attribute("PostCode")?.Value ?? "-"), *@
                                @*страна *@ @(_address.Element("Address")?.Attribute("CountryName")?.Value ?? _address.Element("Address")?.Attribute("AnotherCountryName")?.Value ?? "-"),
                                @*фиас @(_address.Element("Address")?.Attribute("FiasNum")?.Value ?? "-"), *@
                                @*нас. пункт*@ @(_address.Element("Address")?.Attribute("LocalityName")?.Value ?? _address.Element("Address")?.Attribute("OtherLocalityName")?.Value ?? "-"),
                                ул. @(_address.Element("Address")?.Attribute("Street")?.Value ?? "-"),
                                д. @(_address.Element("Address")?.Attribute("HouseNum")?.Value ?? "-"),
                                владение @(_address.Element("Address")?.Attribute("Ownership")?.Value ?? "-"),
                                к. @(_address.Element("Address")?.Attribute("Housing")?.Value ?? "-"),
                                стр. @(_address.Element("Address")?.Attribute("Building")?.Value ?? "-"),
                                кв. @(_address.Element("Address")?.Attribute("FlatNum")?.Value ?? "-")
                            </td>
                            <td>@_address?.Attribute("ActualityDate")?.Value</td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if ((_mainPart?.Descendants("AddressOld")?.Where(x => x.Element("Caption")?.Attribute("ID")?.Value == "2").Any() ?? false) || (_mainPart?.Descendants("AddressInfo")?.Where(a => (a?.Attribute("ActualAddressDif")?.Value ?? a?.Attribute("IsActualAddress")?.Value ?? "0").Equals("1"))?.Any() ?? false))
    {
        <div class="document__table-content document__table--general">
            <table class="document__table">
                <thead>
                    <tr>
                        <td>Адрес фактического проживания</td>
                        <td>Дата актуальности</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ad in _mainPart?.Descendants("AddressOld")?.Where(x => x.Element("Caption")?.Attribute("ID")?.Value == "2") ?? Enumerable.Empty<XElement>())
                    {
                        <tr>
                            <td>@ad?.Element("AddressString")?.Value д. @ad?.Element("StreetAddress")?.Attribute("HouseNum")?.Value кв. @ad?.Element("StreetAddress")?.Attribute("FlatNum")?.Value</td>
                            <td>@ad?.Attribute("ActualityDate")?.Value</td>
                        </tr>
                    }
                    @foreach (var _address in _mainPart?.Descendants("AddressInfo")?.Where(a => (a?.Attribute("ActualAddressDif")?.Value ?? a?.Attribute("IsActualAddress")?.Value ?? "0").Equals("1")) ?? Enumerable.Empty<XElement>())
                    {
                        <tr>
                            <td>
                                @*индекс @(_address.Element("Address")?.Attribute("PostCode")?.Value ?? "-"), *@
                                @*страна*@ @(_address.Element("Address")?.Attribute("CountryName")?.Value ?? _address.Element("Address")?.Attribute("AnotherCountryName")?.Value ?? "-"),
                                @*фиас @(_address.Element("Address")?.Attribute("FiasNum")?.Value ?? "-"), *@
                                @*нас. пункт*@ @(_address.Element("Address")?.Attribute("LocalityName")?.Value ?? _address.Element("Address")?.Attribute("OtherLocalityName")?.Value ?? "-"),
                                ул. @(_address.Element("Address")?.Attribute("Street")?.Value ?? "-"),
                                д. @(_address.Element("Address")?.Attribute("HouseNum")?.Value ?? "-"),
                                владение @(_address.Element("Address")?.Attribute("Ownership")?.Value ?? "-"),
                                к. @(_address.Element("Address")?.Attribute("Housing")?.Value ?? "-"),
                                стр. @(_address.Element("Address")?.Attribute("Building")?.Value ?? "-"),
                                кв. @(_address.Element("Address")?.Attribute("FlatNum")?.Value ?? "-")
                            </td>
                            <td>@_address?.Attribute("ActualityDate")?.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}


@if (_mainPart?.Descendants("Phone")?.Any() ?? false)
{
    <div class="document__caption"><span class="document__table-icon"><img src="img/phone-grey.svg" alt="">  Номера телефонов </span></div>
    <div class="document__table-content document__table--general">
        <table class="document__table">
            <thead>
                <tr>
                    <td>Тип</td>
                    <td>Номер телефона</td>
                    <td>Дата актуальности</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var _phone in _mainPart?.Descendants("Phone") ?? Enumerable.Empty<XElement>())
                {
                    <tr>
                        <td>@_dictionary.PhoneType[_phone.Attribute("ID")?.Value ?? "-"]</td>
                        <td>@(_phone.Attribute("Number")?.Value ?? "-")</td>
                        <td>@(_phone.Attribute("ActualityDate")?.Value ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


@if (_mainPart?.Descendants("EMail")?.Any() ?? false)
