@if (_mainPart?.Descendants("Incapacity").Any() ?? false)
{
    <div class="document__caption"><span class="document__table-icon">@*<img src="img/doc-1.svg" alt="">*@  Сведения о дееспособности </span></div>

    <div class="document__list">
        @foreach (var _incapacity in _mainPart?.Descendants("Incapacity") ?? Enumerable.Empty<XElement>())
        {
            <div class="document__list-item">
                <table class="document__list-content">
                    <tr>
                        <td class="document__list-icon"><img src="img/Incapacity.svg" alt=""></td>
                        <td class="document__columns">
                            <table>
                                <tr>
                                    <td class="document__column" colspan="3">
                                        <div class="document__column-title">Статус недееспособности:</div>
                                        <ul class="document__column-text">
                                            <li>@(_dictionary.IncapacityCode[_incapacity.Attribute("Status")!.Value])</li>
                                        </ul>
                                    </td>
                                    <td class="document__column">
                                        <div class="document__column-title">Дата актуальности:</div>
                                        <ul class="document__column-text">
                                            <li>
                                                @(_incapacity.Attribute("ActualityDate")?.Value ?? "-")
                                            </li>
                                        </ul>
                                    </td>
                                </tr>
                                @foreach (var _courtInfo in _incapacity.Elements("IncapacityCourtInfo") ?? Enumerable.Empty<XElement>())
                                {
                                    @if (_courtInfo.Element("CourtInfo") is not null)
                                    {
                                        <tr>
                                            <td class="document__column" colspan="4">
                                                <div class="document__column-title">Информация решения суда:</div>
                                                <ul class="document__column-text">
                                                    <li>@(_incapacity.Elements("IncapacityCourtInfo")?.First()?.Element("CourtInfo")!.Value ?? "-")</li>
                                                </ul>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td class="document__column">
                                                <div class="document__column-title">Наименование судебного органа:</div>
                                                <ul class="document__column-text">
                                                    <li>@(_courtInfo.Element("CourtData")?.Attribute("Name")?.Value ?? "-")</li>
                                                </ul>
                                            </td>
                                            <td class="document__column">
                                                <div class="document__column-title">Место нахождения судебного органа:</div>
                                                <ul class="document__column-text">
                                                    <li>
                                                        @(_courtInfo.Element("CourtData")?.Attribute("Locality")?.Value ?? "-")
                                                    </li>
                                                </ul>
                                            </td>
                                            <td class="document__column">
                                                <div class="document__column-title">Номер дела/решения:</div>
                                                <ul class="document__column-text">
                                                    <li>@(_courtInfo.Element("CourtData")?.Attribute("CaseId")?.Value ?? "-")</li>
                                                </ul>
                                            </td>
                                            <td class="document__column">
                                                <div class="document__column-title">Информация резолютивной части решения/постановления:</div>
                                                <ul class="document__column-text">
                                                    <li>@(_courtInfo.Element("CourtData")?.Attribute("Decision")?.Value ?? "-")</li>
                                                </ul>
                                            </td>
                                        </tr>
                                        @foreach (var _date in _courtInfo.Element("CourtData")?.Elements("CourtDate") ?? Enumerable.Empty<XElement>())
                                        {
                                            <tr>
                                                <td class="document__column" colspan="2">
                                                    <div class="document__column-title">Тип даты:</div>
                                                    <ul class="document__column-text">
                                                        <li>@(_dictionary.DateType[_date.Attribute("ID")?.Value ?? "-"])</li>
                                                    </ul>
                                                </td>
                                                <td class="document__column" colspan="2">
                                                    <div class="document__column-title">Дата:</div>
                                                    <ul class="document__column-text">
                                                        <li>
                                                            @(_date.Attribute("Date")?.Value ?? "-")
                                                        </li>
                                                    </ul>
                                                </td>
                                            </tr>
                                        }
                                    }
                                }

                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        }
    </div>

}


@if (_mainPart?.Descendants("IndividualEntrepreneur").Any() ?? false)
{
    <div class="document__caption"><span class="document__table-icon">@*<img src="img/doc-1.svg" alt="">*@  Сведения о регистрации физического лица в качестве индивидуального предпринимателя </span></div>
    @foreach (var _individual in _mainPart?.Descendants("IndividualEntrepreneur") ?? Enumerable.Empty<XElement>())
    {
        <div class="document__table-content document__table--general">
            <table class="document__table">
                <thead>
                    <tr>
                        <td>Регистрационный номер</td>
                        <td>Дата выдачи свидетельства о регистрации индивидуального предпринимателя</td>
                        <td>Информация о регистрации индивидуального предпринимателя</td>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@(_individual.Attribute("PSRN")?.Value ?? _individual.Attribute("ForeignRegNumber")?.Value ?? "-")</td>
                        <td>@(_individual.Attribute("RegDate")?.Value ?? "-")</td>
                        <td>@(_individual.Attribute("RegData")?.Value ?? "-")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
}

@if ((_mainPart?.Descendants("Bankruptcy").Any() ?? false) || (_mainPart?.Descendants("BankruptcyOld")?.Any() ?? false))
{
    <div class="document__caption"><span class="document__table-icon">@*<img src="img/doc-1.svg" alt="">*@ Сведения о состоянии банкротства субъекта кредитной истории </span></div>
    <div class="document__list">
        @foreach (var _bankruptcy in _mainPart?.Descendants("Bankruptcy") ?? Enumerable.Empty<XElement>())
        {
            <div class="document__list-item">
                @*<div class="document__item-title">Сведения о состоянии банкротства субъекта кредитной истории</div>*@
                <table class="document__list-content">
                    <tr>
                        <td class="document__list-icon"><img src="img/Bankruptcy.svg" alt=""></td>
                        <td class="document__columns">
                            <table>
                                <tr>
                                    <td class="document__column">
                                        <div class="document__column-title">Cтадия рассмотрения дела о банкротстве:</div>
                                        <ul class="document__column-text">
                                            <li>@_dictionary.BankruptcyStageCode[_bankruptcy.Attribute("StageCode")?.Value ?? "-"]</li>
                                        </ul>
                                    </td>
                                    <td class="document__column">
                                        <div class="document__column-title">Дата публикации в ЕФРСБ:</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.Attribute("CaseDate")?.Value ?? "-")</li>
                                        </ul>
                                    </td>
                                    <td class="document__column">
                                        <div class="document__column-title">Ссылка на публикацию сведений в ЕФРСБ:</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.Attribute("PublicationLink")?.Value ?? "-")</li>
                                        </ul>
                                    </td>
                                    <td class="document__column">
                                        <div class="document__column-title">Наличие неправомерных действий в деле о банкротстве:</div>
                                        <ul class="document__column-text">
                                            <li>@((_bankruptcy.Attribute("IllegalActions")?.Value ?? "-").Equals("1") ? "Да" : "Нет")</li>
                                        </ul>
                                    </td>
                                    <td class="document__column">
                                        <div class="document__column-title">Дата публикации в ЕФРСБ сообщения о неправомерных действиях:</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.Attribute("IllegalActionsDate")?.Value ?? "-")</li>
                                        </ul>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="document__column">
                                        <div class="document__column-title">Преднамеренное или фиктивное банкротство:</div>
                                        <ul class="document__column-text">
                                            <li>@((_bankruptcy.Attribute("FictitiousBankruptcy")?.Value ?? "-").Equals("1") ? "Да" : "Нет")</li>
                                        </ul>
                                    </td>
                                    <td class="document__column">
                                        <div class="document__column-title">Дата публикации в ЕФРСБ сообщения о признаках преднамеренного или фиктивного банкротства:</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.Attribute("FictitiousBankruptcyDate")?.Value ?? "-")</li>
                                        </ul>
                                    </td>
                                    <td class="document__column" colspan="3">
                                        <div class="document__column-title">Дополнительные сведения по делу:</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.Attribute("AdditionalInfo")?.Value ?? "-")</li>
                                        </ul>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        }
        @foreach (var _bankruptcy in _mainPart?.Descendants("BankruptcyOld") ?? Enumerable.Empty<XElement>())
        {
            <div class="document__list-item">
                @*<div class="document__item-title">Сведения о состоянии банкротства субъекта кредитной истории</div>*@
                <table class="document__list-content">
                    <tr>
                        <td class="document__list-icon"><img src="img/doc-1.svg" alt=""></td>
                        <td class="document__columns">
                            <table>
                                <tr>
                                    <td class="document__column" colspan="2">
                                        <div class="document__column-title">Статус состояния банкротства:</div>
                                        <ul class="document__column-text">
                                            <li>@_dictionary.BankruptcyStatusCode[_bankruptcy.Attribute("Status")?.Value ?? "-"]</li>
                                        </ul>
                                    </td>
                                    <td class="document__column" colspan="1">
                                        <div class="document__column-title">Дата актуальности:</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.Attribute("CreationDate")?.Value ?? "-")</li>
                                        </ul>
                                    </td>
                                    <td class="document__column" colspan="1">
                                        <div class="document__column-title">Источник КИ:</div>
                                        <ul class="document__column-text">
                                            <li>GetOwnerById(_bankruptcy.Attribute("OwnerID")!.Value).Caption</li>
                                        </ul>
                                    </td>
                                </tr>
                                @if (_bankruptcy.Element("EFRSBData") is not null)
                                {
                                    <tr>
                                        <td class="document__column" colspan="2">
                                            <div class="document__column-title">Номер записи о банкротстве на сайте ЕФРСБ:</div>
                                            <ul class="document__column-text">
                                                <li>@(_bankruptcy.Element("EFRSBData")?.Attribute("ID")?.Value ?? "-")</li>
                                            </ul>
                                        </td>
                                        <td class="document__column" colspan="2">
                                            <div class="document__column-title">Дата внесения записи о банкротстве на сайте ЕФРСБ:</div>
                                            <ul class="document__column-text">
                                                <li>@(_bankruptcy.Element("EFRSBData")?.Attribute("Date")?.Value ?? "-")</li>
                                            </ul>
                                        </td>
                                    </tr>
                                }
                                @foreach (var _info in _bankruptcy.Elements("BankruptcyCourtInfo") ?? Enumerable.Empty<XElement>())
                                {
                                    @if (_info.Element("CourtInfo") is not null)
                                    {
                                        <tr>
                                            <td class="document__column" colspan="4">
                                                <div class="document__column-title">Информация решения суда в текстовом виде:</div>
                                                <ul class="document__column-text">
                                                    <li>
                                                        @(_info.Element("CourtInfo")!.Value)
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td class="document__column">
                                                <div class="document__column-title">Наименование судебного органа:</div>
                                                <ul class="document__column-text">
                                                    <li>
                                                        @(_info.Element("CourtData")?.Attribute("Name")?.Value ?? "-")
                                                    </li>
                                                </ul>
                                            </td>
                                            <td class="document__column">
                                                <div class="document__column-title">Место нахождения судебного органа:</div>
                                                <ul class="document__column-text">
                                                    <li>
                                                        @(_info.Element("CourtData")?.Attribute("Locality")?.Value ?? "-")
                                                    </li>
                                                </ul>
                                            </td>
                                            <td class="document__column">
                                                <div class="document__column-title">Номер дела / решения:</div>
                                                <ul class="document__column-text">
                                                    <li>
                                                        @(_info.Element("CourtData")?.Attribute("CaseId")?.Value ?? "-")
                                                    </li>
                                                </ul>
                                            </td>
                                            <td class="document__column" colspan="2">
                                                <div class="document__column-title">Информация резолютивной части решения / постановления:</div>
                                                <ul class="document__column-text">
                                                    <li>
                                                        @(_info.Element("CourtData")?.Attribute("Decision")?.Value ?? "-")
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                        @foreach (var _date in _info.Elements("CourtDate") ?? Enumerable.Empty<XElement>())
                                        {
                                            <tr>
                                                <td class="document__column">
                                                    <div class="document__column-title">Тип даты:</div>
                                                    <ul class="document__column-text">
                                                        <li>
                                                            @(_dictionary.DateType[_date.Attribute("ID")?.Value ?? "-"])
                                                        </li>
                                                    </ul>
                                                </td>
                                                <td class="document__column">
                                                    <div class="document__column-title">Дата:</div>
                                                    <ul class="document__column-text">
                                                        <li>
                                                            @(_date.Attribute("Date")?.Value ?? "-")
                                                        </li>
                                                    </ul>
                                                </td>
                                            </tr>
                                        }
                                    }
                                }
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        }
    </div>
}

@if (_mainPart?.Descendants("CompletionOfSettlements")?.Any() ?? false)
{
    <div class="document__caption"><span class="document__table-icon">@*<img src="img/doc-1.svg" alt="">*@  Сведения о завершении расчетов с кредиторами и освобождении субъекта от исполнения обязательств в связи с банкротством </span></div>
