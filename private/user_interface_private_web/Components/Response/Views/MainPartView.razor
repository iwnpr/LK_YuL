                                    <div class="document__column-title">Наименование суда:</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(
                                                _debt.Attribute("CourtName")?.Value ?? "-"
                                                )
                                        </li>
                                    </ul>
                                </td>
                                <td class="document__column" colspan="2">
                                    <div class="document__column-title">Резолютивная часть судебного акта:</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(
                                                _debt.Attribute("JudgementOperativePart")?.Value ?? "-"
                                                )
                                        </li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">Номер исполнительного документа:</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(
                                                _debt.Attribute("ExecutiveDocumentNum")?.Value ?? "-"
                                                )
                                        </li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td class="document__column">
                                    <div class="document__column-title">Дата прекращения взыскания:</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(
                                                _debt.Attribute("TerminationDate")?.Value ?? "-"
                                                )
                                        </li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">Сумма единовременного взыскания:</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(
                                                _debt.Attribute("One-timeCollectionSum")?.Value ?? "-"
                                                ) @(
                                              _debt.Attribute("DebtCollectionCurrency")?.Value ?? ""
                                              )
                                        </li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">Взысканная сумма:</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(
                                                _debt.Attribute("CollectedSum")?.Value ?? "-"
                                                ) @(
                                              _debt.Attribute("DebtCollectionCurrency")?.Value ?? ""
                                              )
                                        </li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">Дата расчета:</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(
                                                _debt.Attribute("CalculationDate")?.Value ?? "-"
                                                )
                                        </li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">Сумма периодического взыскания:</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(
                                                _debt.Attribute("PeriodicCollectionSum")?.Value ?? "-"
                                                ) @(
                                              _debt.Attribute("DebtCollectionCurrency")?.Value ?? ""
                                              )
                                        </li>
                                    </ul>
                                </td>
                                <td class="document__column" colspan="2">
                                    <div class="document__column-title">Периодичность платежей:</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(
                                                _dictionary.FrequencyCode[_debt.Attribute("PaymentFrequencyCode")?.Value ?? "-"]
                                                )
                                        </li>
                                    </ul>
                                </td>
                                
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    }
</div>
        }



@code {
    [Parameter] public XDocument Response { get; set; } = new(new XElement("RESPONSE"));

    private XElement _mainPart = new("MainPart");
    private XElement _titlePart = new("TitlePart");
    private XElement _ampQbch = new XElement("AMPQCB");

    protected override void OnInitialized()
    {
        _mainPart = Response.Descendants("MainPart").FirstOrDefault() ?? new("MainPart");
    }
