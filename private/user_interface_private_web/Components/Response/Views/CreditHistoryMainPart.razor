<h2 class="document__title document__title--h2 document__title--black">Основная часть кредитной истории</h2>

@if ((Report?.MainPart?.AddrOld?.Any() ?? false) || (Report?.MainPart?.AddrReg?.Any() ?? false) || (Report?.MainPart?.AddrFact?.Any() ?? false))
{
    <div class="document__caption"><span class="document__table-icon"><img src="img/location.svg" alt="">  Адреса субъекта </span></div>

    @if ((Report?.MainPart?.AddrOld?.Any(x => x.addressCode == "1") ?? false) || (Report?.MainPart?.AddrReg?.Any() ?? false))
    {
        <div class="document__table-content document__table--general">
            <table class="document__table">
                <thead>
                    <tr>
                        <td style="width:50%">Адрес регистрации по месту жительства</td>
                        <td>Дата актуальности</td>
                    </tr>
                </thead>
                <tbody>
                    @if (Report?.MainPart?.AddrOld is not null)
                        @foreach (var ad in Report?.MainPart?.AddrOld?.Where(x => x.addressCode == "1")?.ToList() ?? new())
                        {
                            <tr>
                                <td>@ad?.address</td>
                                <td>@ad?.actualityDate?.ToRussianDate()</td>
                            </tr>
                        }
                    @if (Report?.MainPart?.AddrReg?.Any() ?? false)
                        @foreach (var _address in Report?.MainPart?.AddrReg ?? new())
                        {
                            <tr>
                                <td>
                                    индекс @(_address.postCode ?? "-"),
                                    @*страна *@ @(_address.countryCode ?? _address.countryOther ?? "-"),
                                    @*фиас @(_address.Address?.FiasNum ?? "-"), *@
                                    @*нас. пункт*@ @(_address.locationCode ?? _address.locationOther ?? "-"),
                                    @*ГАР*@ @(_address.regStateNum ?? "-")
                                    ул. @(_address.street ?? "-"),
                                    д. @(_address.house ?? "-"),
                                    владение @(_address.estate ?? "-"),
                                    к. @(_address.block ?? "-"),
                                    стр. @(_address.build ?? "-"),
                                    кв. @(_address.apart ?? "-")
                                </td>
                                <td>@_address?.actualityDate?.ToRussianDate()</td>
                            </tr>
                        }
                </tbody>
            </table>
        </div>
    }

    @if ((Report?.MainPart?.AddrOld?.Any(x => x.addressCode == "2") ?? false) || (Report?.MainPart?.AddrFact?.Any() ?? false))
    {
        <div class="document__table-content document__table--general">
            <table class="document__table">
                <thead>
                    <tr>
                        <td style="width:50%">Адрес фактического проживания</td>
                        <td style="width:50%">Дата актуальности</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ad in Report?.MainPart?.AddrOld?.Where(x => x.addressCode == "2")?.ToList() ?? new())
                    {
                        <tr>
                            <td>@ad?.address</td>
                            <td>@ad?.actualityDate?.ToRussianDate()</td>
                        </tr>
                    }
                    @foreach (var _address in Report?.MainPart?.AddrFact ?? new())
                    {
                        <tr>
                            <td>
                                @(_address.postCode ?? "-"),
                                @*страна *@ @(_address.countryCode ?? _address.countryOther ?? "-"),
                                @*фиас @(_address.Address?.FiasNum ?? "-"), *@
                                @*нас. пункт*@ @(_address.locationCode ?? _address.locationOther ?? "-"),
                                @*ГАР*@ @(_address.regStateNum ?? "-")
                                ул. @(_address.street ?? "-"),
                                д. @(_address.house ?? "-"),
                                владение @(_address.estate ?? "-"),
                                к. @(_address.block ?? "-"),
                                стр. @(_address.build ?? "-"),
                                кв. @(_address.apart ?? "-")
                            </td>
                            <td>@_address?.actualityDate?.ToRussianDate()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (Report?.MainPart?.Contact?.Where(item => (item.Phone_group?.Any() ?? false)).Any() ?? false)
{
    <div class="document__caption"><span class="document__table-icon"><img src="img/phone-grey.svg" alt="" />  Номера телефонов </span></div>
    <div class="document__table-content document__table--general">
        <table class="document__table">
            <thead>
                <tr>
                    <td>Номер телефона</td>
                    <td>Комментарий</td>
                    <td>Дата актуальности</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var _phone in Report?.MainPart?.Contact.SelectMany(item => item.Phone_group ?? new(), (contact, phone) => new { contact, phone })?.ToList() ?? new())
                {
                    <tr>
                        <td>@_phone.phone.phone</td>
                        <td>@(_phone.phone.phoneComment ?? "")</td>
                        <td>@(_phone.contact.actualityDate?.ToRussianDate() ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Report?.MainPart?.Contact?.Where(item => (item.email?.Any() ?? false)).Any() ?? false)
{
    <div class="document__caption"><span class="document__table-icon"><img src="img/email-grey.svg" alt="" />  Адреса электронной почты </span></div>
    <div class="document__table-content document__table--general">
        <table class="document__table">
            <thead>
                <tr>
                    <td>Электронная почта</td>
                    <td>Дата актуальности</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var _email in Report?.MainPart?.Contact.Where(item => (item.email?.Any() ?? false))?.SelectMany(item => item.email ?? new(), (contact, email) => new { contact, email })?.ToList() ?? new())
                {
                    <tr>
                        <td>@(_email.email ?? "-")</td>
                        <td>@_email.contact?.actualityDate?.ToRussianDate()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Report?.MainPart?.IndividualEntrepreneur?.Any() ?? false)
{
    <div class="document__caption"><span class="document__table-icon">@*<img src="img/doc-1.svg" alt=""/>*@  Сведения о регистрации физического лица в качестве индивидуального предпринимателя </span></div>
    <div class="document__table-content document__table--general">
        <table class="document__table">
            <thead>
                <tr>
                    <td>Регистрационный номер</td>
                    <td>Дата выдачи свидетельства о регистрации индивидуального предпринимателя</td>
                    <td>Дата прекращения статуса индивидуального предпринимателя</td>
                    <td>Дата актуальности</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var _individual in Report?.MainPart.IndividualEntrepreneur ?? new())
                {
                    <tr>
                        <td>@(_individual.regNum ?? "-")</td>
                        <td>@(_individual.date?.ToRussianDate() ?? "-")</td>
                        <td>@(_individual.endDate?.ToRussianDate() ?? "-")</td>
                        <td>@(_individual.actualityDate?.ToRussianDate() ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Report?.MainPart?.Capacity?.Any() ?? false)
{
    <div class="document__caption"><span class="document__table-icon">@*<img src="img/doc-1.svg" alt=""/>*@  Сведения о дееспособности </span></div>

    <div class="document__list">
        @foreach (var _incapacity in Report?.MainPart.Capacity ?? new())
        {
            <div class="document__list-item">
                <table class="document__list-content">
                    <tr>
                        <td class="document__list-icon"><img src="img/Incapacity.svg" alt="" /></td>
                        <td class="document__columns">
                            <table>
                                <tr>
                                    <td class="document__column" colspan="2">
                                        <div class="document__column-title">Статус дееспособности</div>
                                        <ul class="document__column-text">
                                            <li>@_dictionary.Reference_75.TryGetValueOrDefault(_incapacity.code)</li>
                                        </ul>
                                    </td>
                                    <td class="document__column">
                                        <div class="document__column-title">Дата актуальности</div>
                                        <ul class="document__column-text">
                                            <li>
                                                @(_incapacity.actualityDate?.ToRussianDate() ?? "-")
                                            </li>
                                        </ul>
                                    </td>
                                </tr>
                                @if (_incapacity.Incapacity_group is not null || _incapacity.LegalCapacity_group is not null)
                                {
                                    <tr>
                                        <td class="document__column">
                                            <div class="document__column-title">Наименование судебного органа</div>
                                            <ul class="document__column-text">
                                                <li>@(_incapacity.Incapacity_group?.incapacityCourtName ?? _incapacity.LegalCapacity_group?.legalCapacityCourtName ?? "-")</li>
                                            </ul>
                                        </td>
                                        <td class="document__column">
                                            <div class="document__column-title">Номер решения</div>
                                            <ul class="document__column-text">
                                                <li>@(_incapacity.Incapacity_group?.incapacityDecisionNum ?? _incapacity.LegalCapacity_group?.legalCapacityDecisionNum ?? "-")</li>
                                            </ul>
                                        </td>
                                        <td class="document__column">
                                            <div class="document__column-title">Дата вступления в силу решения суда о признании @(_incapacity.Incapacity_group is not null ? "недееспособным или об ограничении дееспособности" : "дееспособным или об отмене ограничения дееспособности")</div>
                                            <ul class="document__column-text">
                                                <li>@(_incapacity.Incapacity_group?.incapacityDate?.ToRussianDate() ?? _incapacity.LegalCapacity_group?.legalCapacityDate?.ToRussianDate() ?? "-")</li>
                                            </ul>
                                        </td>
                                    </tr>
                                }
                            </table>
                        </td>
                    </tr>
                </table>
                <hr class="splitter" />
            </div>
        }
    </div>
}

@if (Report?.MainPart?.Bankruptcy?.Any() ?? false)
{
    <div class="document__caption"><span class="document__table-icon">@*<img src="img/doc-1.svg" alt=""/>*@ Сведения по делу о несостоятельности (банкротстве) субъекта кредитной истории </span></div>
    <div class="document__list">
        @foreach (var _bankruptcy in Report?.MainPart.Bankruptcy ?? new())
        {
            <div class="document__list-item">
                @*<div class="document__item-title">Сведения о состоянии банкротства субъекта кредитной истории</div>*@
                <table class="document__list-content">
                    <tr>
                        <td class="document__list-icon"><img src="img/Bankruptcy.svg" alt="" /></td>
                        <td class="document__columns">
                            <table>
                                @foreach (var _date in _bankruptcy.Date_group ?? new())
                                {
                                    <tr>
                                        <td class="document__column">
                                            <div class="document__column-title">Cтадия рассмотрения дела о банкротстве</div>
                                            <ul class="document__column-text">
                                                <li>@_dictionary.Reference_103.TryGetValueOrDefault(_date.stage)</li>
                                            </ul>
                                        </td>
                                        <td class="document__column">
                                            <div class="document__column-title">Ссылка на публикацию в ЕФРСБ</div>
                                            <ul class="document__column-text">
                                                <li>@_date.link</li>
                                            </ul>
                                        </td>
                                        <td class="document__column">
                                            <div class="document__column-title">Дата публикации в ЕФРСБ сведений о стадии рассмотрения</div>
                                            <ul class="document__column-text">
                                                <li>@(_date.date?.ToRussianDate() ?? "-")</li>
                                            </ul>
                                        </td>
                                    </tr>
                                }
                                @if (_bankruptcy.stage is not null || _bankruptcy.link is not null || _bankruptcy.date is not null)
                                {
                                    <tr>
                                        <td class="document__column">
                                            <div class="document__column-title">Cтадия рассмотрения дела о банкротстве</div>
                                            <ul class="document__column-text">
                                                <li>@_dictionary.Reference_103.TryGetValueOrDefault(_bankruptcy.stage)</li>
                                            </ul>
                                        </td>
                                        <td class="document__column">
                                            <div class="document__column-title">Ссылка на публикацию в ЕФРСБ</div>
                                            <ul class="document__column-text">
                                                <li>@_bankruptcy.link</li>
                                            </ul>
                                        </td>
                                        <td class="document__column">
                                            <div class="document__column-title">Дата публикации в ЕФРСБ сведений о стадии рассмотрения</div>
                                            <ul class="document__column-text">
                                                <li>@(_bankruptcy.date?.ToRussianDate() ?? "-")</li>
                                            </ul>
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <td class="document__column">
                                        <div class="document__column-title">Наличие неправомерных действий в деле о банкротстве</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.illegalActExist_1 is not null ? "Да" : "Нет")</li>
                                        </ul>
                                    </td>
                                    <td class="document__column" colspan="2">
                                        <div class="document__column-title">Дата публикации в ЕФРСБ сообщения о неправомерных действиях</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.illegalActDate?.ToRussianDate() ?? "-")</li>
                                        </ul>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="document__column">
                                        <div class="document__column-title">Преднамеренное или фиктивное банкротство</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.fakeActExist_1 is not null ? "Да" : "Нет")</li>
                                        </ul>
                                    </td>
                                    <td class="document__column" colspan="2">
                                        <div class="document__column-title">Дата публикации в ЕФРСБ сообщения о признаках преднамеренного или фиктивного банкротства</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.fakeActDate?.ToRussianDate() ?? "-")</li>
                                        </ul>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="document__column">
                                        <div class="document__column-title">Дополнительные сведения по делу</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.info ?? "-")</li>
                                        </ul>
                                    </td>
                                    <td class="document__column">
                                        <div class="document__column-title">Дата актуальности</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.actualityDate?.ToRussianDate() ?? "-")</li>
                                        </ul>
                                    </td>

                                    <td class="document__column">
                                        <div class="document__column-title">Номер дела о банкротстве</div>
                                        <ul class="document__column-text">
                                            <li>@(_bankruptcy.num ?? "-")</li>
                                        </ul>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
                <hr class="splitter" />
            </div>
        }
    </div>
}

@if (Report?.MainPart?.BankruptcyEnd?.Any() ?? false)
{
    <div class="document__caption"><span class="document__table-icon">@*<img src="img/doc-1.svg" alt=""/>*@  Сведения о завершении расчетов с кредиторами и освобождении субъекта от исполнения обязательств в связи с банкротством </span></div>
    <div class="document__table-content document__table--general">
        <table class="document__table">
            <thead>
                <tr>
                    <td>Завершение расчетов с кредиторами</td>
                    @if (Report?.TitlePart?.FL_TitlePart is not null)
                    {
                        <td>Дата восстановления обязательства</td>
                    }
                    <td>Дата завершения расчетов с кредиторами</td>
                    @if (Report?.TitlePart?.FL_TitlePart is not null)
                    {
                        <td>Освобождение от исполнения требований кредиторов</td>
                        <td>Дата освобождения от исполнения требований кредиторов</td>
                    }
                    <td>Дата актуальности</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var _settlement in Report?.MainPart.BankruptcyEnd ?? new())
                {
                    <tr>
                        <td>@(_settlement.bankruptcyEndFact_1 is not null ? "Да" : "Нет")</td>
                        @if (Report?.TitlePart?.FL_TitlePart is not null)
                        {
                            <td>@(_settlement.resumeDate?.ToRussianDate() ?? "-")</td>
                        }
                        <td>@(_settlement.completionDate?.ToRussianDate() ?? "-")</td>
                        @if (Report?.TitlePart?.FL_TitlePart is not null)
                        {
                            <td>@(_settlement.settlementExist_1 is not null ? "Да" : "Нет")</td>
                            <td>@(_settlement.completionDate?.ToRussianDate() ?? "-")</td>
                        }
                        <td>@(_settlement.actualityDate?.ToRussianDate() ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Report?.MainPart?.DebtBurdenInfo?.Any() ?? false)
{
    <div class="document__caption"><span class="document__table-icon">@*<img src="img/location.svg" alt=""/>*@ Сведения о долговой нагрузке заемщика </span></div>
    <div class="document__list">
        @foreach (var _debt in Report?.MainPart?.DebtBurdenInfo ?? new())
        {
            <table class="document__list-content">
                <tr>
                    <td class="document__list-icon"><img src="img/doc-1.svg" alt="" /></td>
                    <td class="document__columns">
                        <table>
                            <tr>
                                <td class="document__column">
                                    <div class="document__column-title">Диапазон показателя долговой нагрузки заемщика</div>
                                    <ul class="document__column-text">
                                        <li>@_dictionary.Reference_134.TryGetValueOrDefault(_debt.loadRange)</li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">Дата расчета показателя долговой нагрузки заемщика</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(_debt.loadCalcDate?.ToRussianDate() ?? "-")
                                        </li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">Сведения о способе определения величины среднемесячного дохода заемщика</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(_debt.incomeInfo ?? "-")
                                        </li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td class="document__column" colspan="3">
                                    <div class="document__column-title">Источник сведений о величине среднемесячного дохода заемщика</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(_dictionary.Reference_136.TryGetValueOrDefault(_debt.incomeInfoSource?.FirstOrDefault()))
                                        </li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td class="document__column">
                                    <div class="document__column-title">Наличие учета долговой нагрузки созаемщиков</div>
                                    <ul class="document__column-text">
                                        <li>@(_debt.loadFact_1 is not null ? "Да" : "Нет")</li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">Наличие расчета показателя долговой нагрузки заемщика по заключенному потребительскому кредиту (займу)</div>
                                    <ul class="document__column-text">
                                        <li>@(_debt.loadCalculationFact_1 is not null ? "Да" : "Нет")</li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">УИд сделки (УИд обращения)</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(_debt.dealUid)
                                        </li>
                                    </ul>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <hr class="splitter" />
        }
    </div>
}

@foreach (var _credit in Report?.MainPart?.CreditRecord?.Where(c => !(c.AvgPayment?.Any() ?? false))?.ToList() ?? new())
{
    <div class="document__caption">
        <span class="document__table-icon">
            @*<img src="img/doc-1.svg" alt=""/>*@  Запись кредитной истории по договору (сделке)
        </span>
    </div>
    <div class="document__list">
        @*Идентификатор сделки*@
        <div class="document__list-item">
            <div class="document__item-title">Идентификатор сделки</div>
            <table class="document__list-content">
                <tr>
                    <td class="document__list-icon"><img src="img/doc-id.svg" alt="" /></td>
                    <td class="document__columns">
                        <table>
                            <tr>
                                <td class="document__column">
                                    <div class="document__column-title">Уникальный идентификатор договора (сделки)</div>
                                    <ul class="document__column-text">
                                        <li>@(_credit.DealUid?.uid ?? "-")</li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">Номер сделки</div>
                                    <ul class="document__column-text">
                                        <li>@(_credit.DealUid?.num ?? "-")</li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">Дата совершения сделки</div>
                                    <ul class="document__column-text">
                                        <li>@(_credit.DealUid?.openDate?.ToRussianDate() ?? "-")</li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td class="document__column">
                                    <div class="document__column-title">УИд сделки, по которой задолженность была полностью или частично рефинансирована</div>
                                    <ul class="document__column-text">
                                        <li>@(_credit.DealUid?.refUid?.FirstOrDefault() ?? "-")</li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">Дата последнего обновления информации по договору</div>
                                    <ul class="document__column-text">
                                        <li>@(_credit.lastUpdateInfoDate?.ToRussianDate() ?? "-")</li>
                                    </ul>
                                </td>
                                <td class="document__column">
                                    <div class="document__column-title">Дата актуальности</div>
                                    <ul class="document__column-text">
                                        <li>@(_credit.DealUid?.actualityDate?.ToRussianDate() ?? "-")</li>
                                    </ul>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
            <hr class="splitter" />
        </div>


        @*Общие сведения о договоре*@
        <div class="document__list-item">
            <div class="document__item-title">Общие сведения о сделке</div>

            <table class="document__list-content">
                <tr>
                    <td class="document__list-icon"><img src="img/CreditDeal.svg" alt="" /></td>
                    <td class="document__columns">
                        <table>
                            <tr>
                                <td class="document__column">
                                    <div class="document__column-title">Вид участия в сделке</div>
                                    <ul class="document__column-text">
                                        <li>@_dictionary.Reference_104.TryGetValueOrDefault(_credit.Deal?.FirstOrDefault()?.role)</li>
                                    </ul>
                                </td>
                                <td class="document__column">
