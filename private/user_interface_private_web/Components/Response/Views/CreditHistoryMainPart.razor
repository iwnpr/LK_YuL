                                <td class="document__column">
                                    <div class="document__column-title">Остаток долга</div>
                                    <ul class="document__column-text">
                                        <li>
                                            @(_debt.debtBalance ?? "-") @(_debt.debtCurrency ?? "-")
                                        </li>
                                    </ul>
                                </td>
                                
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
            <hr class="splitter" />
        }
    </div>
}




