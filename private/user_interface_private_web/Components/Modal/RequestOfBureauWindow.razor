</CascadingValue>


@code {
    [CascadingParameter(Name = "Disabled")] public bool Disabled { get; set; }

/// <summary>
/// Отображение окна
/// </summary>
[Parameter] public bool Show { get; set; } = false;

[Parameter, EditorRequired]
public BureauRequestModel Model { get; set; } = null!;

/// <summary>
/// Согласие
/// </summary>
private Dictionary<string, string> Consent { get; set; } = null!;

/// <summary>
/// Комментарий для информационного модального окна
/// </summary>
private Comment _comment = new Comment(false, string.Empty, string.Empty, string.Empty);


private List<bool> _steps = new() { true, false, false, false, false, false, false };

/// <summary>
/// Тип запроса к сервису
/// </summary>
[Parameter] public RequestType Type { get; set; } = RequestType.check;

/// <summary>
/// Метод запроса к сервису
/// </summary>
[Parameter] public EventCallback Method { get; set; }

[Parameter] public ParametersBureau? RequestParameters { get; set; } = new();

/// <summary>
/// Событие на закрытие формы
/// </summary>
[Parameter] public EventCallback OnClose { get; set; }

protected override async Task OnParametersSetAsync()
{
    if (!Disabled)
    _steps = new() { true, false, false, false, false, false, false };
    await _jsr.InvokeVoidAsync("mask");
}

protected override async  Task OnAfterRenderAsync(bool firstRender)
{
    //_steps = new() { true, false, false, false, false, false, false };
    await _jsr.InvokeVoidAsync("mask");
}

private void OnStepChange(int index)
{
    if (index.Equals(1))
    {
        var answer = _bureauRequestValidator.ValidateSubject(Model);

        if (!answer.Code.Equals(200))
        {
            _comment = new(true, "error", "Запрос в Бюро", answer.Message);
            return;
        }
    }

    for (var i = 0; i < _steps.Count; i++)
    {
    _steps[i] = i.Equals(index);
    }
}
}
