ARG BASE_IMAGE
FROM ${BASE_IMAGE}
# Docker CLI transfers the build context even from mapped/network drives.
# No runtime bind mount of the Windows project directory is required.
COPY --chmod=755 postgres/ /bootstrap/postgres/
COPY --chmod=755 sqlserver/ /bootstrap/sqlserver/
# COPY applies the mode to directories too: SQL Server's non-root user
# needs execute permission to traverse /bootstrap/sql.
COPY --chmod=755 sql/ /bootstrap/sql/
